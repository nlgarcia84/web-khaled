---
import ArrowUp from "lucide-static/dist/esm/icons/arrow-up.mjs";
import { ClientRouter } from "astro:transitions";
import MobileMenu from "../components/MobileMenu.tsx";
import "../styles/global.css";
import { getStream } from "../lib/sanity";
import { getLiveStream } from "../lib/youtube";
interface Props {
  title: string;
}

const { title } = Astro.props;

const stream = await getStream();
const channelId = stream?.channelId ?? "";
const live = channelId ? await getLiveStream(channelId) : null;
const isLive = live !== null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Sheij Khaled Huerta</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body
    class="bg-white text-chocolate font-sans antialiased m-0 p-0 min-h-screen flex flex-col"
  >
    <header class="bg-chocolate sticky top-0 z-50">
      <div
        class="max-w-[1140px] mx-auto px-6 h-20 flex justify-between items-center"
      >
        <div class="logo">
          <a
            href="/"
            class="font-serif text-xl font-bold text-white no-underline tracking-tight"
          >
            Sheij Khaled Huerta
          </a>
        </div>

        <MobileMenu client:load />

        <nav class="hidden md:flex gap-8 items-center">
          <a
            href="/"
            class="text-white/80 hover:text-oro transition-colors duration-200 no-underline font-medium text-sm"
            >Inicio</a
          >
          <a
            href="/biografia"
            class="text-white/80 hover:text-oro transition-colors duration-200 no-underline font-medium text-sm"
            >Biografía</a
          >
          <a
            href="/blog"
            class="text-white/80 hover:text-oro transition-colors duration-200 no-underline font-medium text-sm"
            >Blog</a
          >
          <a
            href="/contact"
            class="text-white/80 hover:text-oro transition-colors duration-200 no-underline font-medium text-sm"
            >Contacto</a
          >
          <a
            href="/jutbas"
            class="text-white/80 hover:text-oro transition-colors duration-200 no-underline font-semibold text-sm inline-flex items-center gap-2"
          >
            Jutbas
            {
              isLive && (
                <span
                  class="inline-flex items-center gap-1 bg-red-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full"
                  title="Hay una emisión en directo"
                >
                  <span class="relative flex h-1.5 w-1.5">
                    <span class="absolute inline-flex h-full w-full rounded-full bg-white opacity-75 animate-ping" />
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-white" />
                  </span>
                  EN DIRECTO
                </span>
              )
            }
          </a>
          <a
            href="/biblioteca"
            class="text-white/80 hover:text-oro transition-colors duration-200 no-underline font-medium text-sm"
            >Biblioteca</a
          >

          <a
            href="/donar"
            class="inline-flex items-center bg-oro text-chocolate hover:bg-oro/90 transition-all duration-200 no-underline font-bold text-sm px-4 py-1.5 rounded-lg"
            >Donaciones</a
          >
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-chocolate text-white/70">
      <div class="max-w-[1140px] mx-auto px-6 py-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div>
            <h3 class="font-serif text-lg font-bold text-white mb-4">
              Sheij Khaled Huerta
            </h3>
            <p class="text-sm leading-relaxed text-white/60">
              Difundiendo el mensaje del Islam en lengua española con rigor,
              sabiduría y cercanía.
            </p>
          </div>
          <div>
            <h4
              class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase mb-4"
            >
              Navegación
            </h4>
            <nav class="flex flex-col gap-3">
              <a
                href="/"
                class="text-white/60 hover:text-oro transition-colors text-sm no-underline"
                >Inicio</a
              >
              <a
                href="/biografia"
                class="text-white/60 hover:text-oro transition-colors text-sm no-underline"
                >Biografía</a
              >
              <a
                href="/blog"
                class="text-white/60 hover:text-oro transition-colors text-sm no-underline"
                >Blog</a
              >
              <a
                href="/contact"
                class="text-white/60 hover:text-oro transition-colors text-sm no-underline"
                >Contacto</a
              >
            </nav>
          </div>
          <div>
            <h4
              class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase mb-4"
            >
              Contacto
            </h4>
            <p class="text-sm text-white/60 leading-relaxed">Formulario</p>
          </div>
        </div>
        <div class="border-t border-white/10 mt-12 pt-8 text-center">
          <p class="text-sm text-white/40">
            &copy; {new Date().getFullYear()} Sheij Khaled Huerta. Todos los derechos
            reservados.
          </p>
          <p class="text-xs text-white/30 mt-2">
            Web desarrollada con <span class="text-red-400">&hearts;</span> por
            <a
              href="https://normanleyva.dev"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/40 hover:text-oro transition-colors no-underline"
            >
              normanleyva.dev</a
            >
          </p>
        </div>
      </div>
    </footer>

    <button
      id="scroll-top-btn"
      aria-label="Volver arriba"
      class="fixed bottom-6 right-6 z-30 w-12 h-12 rounded-full bg-oro text-chocolate shadow-lg hover:shadow-xl hover:bg-oro/90 transition-all duration-300 ease-in-out flex items-center justify-center cursor-pointer opacity-0 translate-y-4 pointer-events-none"
    >
      <span
        set:html={ArrowUp}
        class="w-5 h-5 flex items-center justify-center"
      />
    </button>
  </body>
</html>

<script>
  window.scrollTo(0, 0);
  document.addEventListener("astro:after-swap", () => window.scrollTo(0, 0));

  if (!(window as any).__scrollTopInit) {
    (window as any).__scrollTopInit = true;

    const showBtn = () => {
      const btn = document.getElementById("scroll-top-btn");
      if (!btn) return;
      const shouldShow = window.scrollY > 300;
      btn.classList.toggle("opacity-0", !shouldShow);
      btn.classList.toggle("translate-y-4", !shouldShow);
      btn.classList.toggle("pointer-events-none", !shouldShow);
      btn.classList.toggle("opacity-100", shouldShow);
      btn.classList.toggle("translate-y-0", shouldShow);
      btn.classList.toggle("pointer-events-auto", shouldShow);
    };

    let ticking = false;
    document.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            showBtn();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );

    document.addEventListener("astro:after-swap", showBtn);

    document.addEventListener("click", (e) => {
      if ((e.target as Element).closest?.("#scroll-top-btn")) {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  }
</script>
