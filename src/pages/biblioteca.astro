---
import Layout from "../layouts/Layout.astro";
import { getDocumentos } from "../lib/sanity";

const documentos = await getDocumentos();
---

<Layout title="Biblioteca">
  <section
    class="relative py-20 md:py-28 text-center overflow-hidden flex flex-col justify-center min-h-[calc(100svh-5rem)] md:min-h-[calc(100vh-5rem)]"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-chocolate via-chocolate/95 to-granate/90"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(187,148,87,0.15),transparent_50%)]"></div>

    <div class="relative z-10 max-w-[800px] mx-auto px-6 hero-content">
      <span
        class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-4"
      >
        Recursos
      </span>
      <h1
        class="font-serif text-4xl md:text-6xl font-bold tracking-tight text-white mb-6 leading-tight"
      >
        Biblioteca
      </h1>
      <p
        class="font-sans text-lg md:text-xl text-crema/80 font-light leading-relaxed max-w-2xl mx-auto"
      >
        Documentos, libros y materiales de estudio en PDF y formato editable.
        Todo el contenido está alojado en Google Drive para su consulta y
        descarga.
      </p>
    </div>
  </section>

  <section class="py-20 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      {
        documentos.length === 0 ? (
          <div class="text-center py-16">
            <span class="text-5xl">📚</span>
            <p class="text-marron mt-6 text-lg">
              Próximamente encontrarás aquí los documentos y materiales de
              estudio.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 document-grid">
            {documentos.map((doc) => {
              const icon = doc.type === "pdf" ? "📄" : doc.type === "docx" ? "📝" : "📁";
              const color = doc.type === "pdf" ? "from-red-500/10 to-red-500/5 border-red-200" : "from-blue-500/10 to-blue-500/5 border-blue-200";
              const badge = doc.type === "pdf" ? "bg-red-100 text-red-700" : "bg-blue-100 text-blue-700";

              return (
                <button
                  class={`document-card group bg-gradient-to-br ${color} border rounded-xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 text-left cursor-pointer`}
                  data-fileid={doc.fileId}
                  data-title={doc.title}
                  data-type={doc.type}
                >
                  <div class="flex items-start gap-4">
                    <span class="text-3xl shrink-0">{icon}</span>
                    <div class="min-w-0">
                      <div class="flex items-center gap-2 mb-2">
                        <span
                          class={`text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full ${badge}`}
                        >
                          {doc.type.toUpperCase()}
                        </span>
                      </div>
                      <h3 class="font-serif text-base font-bold text-chocolate leading-snug group-hover:text-granate transition-colors">
                        {doc.title}
                      </h3>
                      {
                        doc.description && (
                          <p class="text-sm text-marron/70 mt-2 line-clamp-2">
                            {doc.description}
                          </p>
                        )
                      }
                      <span
                        class="inline-flex items-center gap-1 text-xs font-medium text-oro mt-3 group-hover:gap-2 transition-all"
                      >
                        Ver documento <span class="text-lg leading-none">&rarr;</span>
                      </span>
                    </div>
                  </div>
                </button>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <div
    id="doc-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
  >
    <div
      class="relative bg-white rounded-2xl shadow-2xl w-[95vw] max-w-5xl h-[85vh] flex flex-col overflow-hidden modal-panel"
    >
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 shrink-0">
        <h3 id="modal-title" class="font-serif text-lg font-bold text-chocolate truncate pr-4"></h3>
        <button
          id="modal-close"
          class="shrink-0 w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-marron"
          aria-label="Cerrar"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-5 h-5" stroke-width="2" stroke-linecap="round">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="flex-1 bg-gray-100">
        <iframe
          id="doc-iframe"
          class="w-full h-full border-0"
          title="Visor de documento"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</Layout>

<script>
  import gsap from "gsap";

  gsap.from(".hero-content > *", {
    y: 50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.12,
    ease: "power2.out",
    force3D: true,
  });

  gsap.from(".document-card", {
    y: 40,
    opacity: 0,
    duration: 0.7,
    stagger: 0.08,
    ease: "power2.out",
    force3D: true,
    scrollTrigger: {
      trigger: ".document-grid",
      start: "top 85%",
    },
  });

  const modal = document.getElementById("doc-modal")!;
  const modalTitle = document.getElementById("modal-title")!;
  const docIframe = document.getElementById("doc-iframe") as HTMLIFrameElement;
  const closeBtn = document.getElementById("modal-close")!;

  function openModal(title: string, fileId: string) {
    modalTitle.textContent = title;
    docIframe.src = `https://drive.google.com/file/d/${fileId}/preview`;
    modal.classList.remove("opacity-0", "pointer-events-none");
    document.body.style.overflow = "hidden";
    gsap.fromTo(
      ".modal-panel",
      { scale: 0.95, opacity: 0, y: 20 },
      { scale: 1, opacity: 1, y: 0, duration: 0.3, ease: "power2.out" },
    );
  }

  function closeModal() {
    modal.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
    docIframe.src = "";
  }

  document.querySelectorAll(".document-card").forEach((card) => {
    card.addEventListener("click", () => {
      const fileId = card.getAttribute("data-fileid")!;
      const title = card.getAttribute("data-title")!;
      openModal(title, fileId);
    });
  });

  closeBtn.addEventListener("click", closeModal);
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>
