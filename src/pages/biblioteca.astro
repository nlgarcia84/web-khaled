---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import { getDocumentos } from "../lib/sanity";
import khaledEscribe from "../assets/images/khaled_escribe.png";

const documentos = await getDocumentos();
const driveFolderId = "16Q2ZHIA23Dqw8z1aMrVisEE_HrJNA_RY";
---

<Layout title="Biblioteca">
  <HeroSection
    image={khaledEscribe}
    label="Recursos"
    title="Biblioteca"
    description="Documentos, libros y materiales de estudio en PDF y formatos editables. Todo el contenido se sincroniza automáticamente desde Google Drive."
    overlay="gradient-dark"
  />

  {
    documentos.length > 0 && (
      <section class="py-16 bg-gris-claro">
        <div class="max-w-[1140px] mx-auto px-6">
          <div class="text-center mb-10">
            <h2 class="font-serif text-xl md:text-2xl font-bold text-chocolate">
              Documentos destacados
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 document-grid">
            {documentos.map((doc) => {
              const icon =
                doc.type === "pdf" ? "📄" : doc.type === "docx" ? "📝" : "📁";
              const color =
                doc.type === "pdf"
                  ? "from-red-500/10 to-red-500/5 border-red-200"
                  : "from-blue-500/10 to-blue-500/5 border-blue-200";
              const badge =
                doc.type === "pdf"
                  ? "bg-red-100 text-red-700"
                  : "bg-blue-100 text-blue-700";

              return (
                <button
                  class={`document-card group bg-gradient-to-br ${color} border rounded-xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 text-left cursor-pointer`}
                  data-fileid={doc.fileId}
                  data-title={doc.title}
                >
                  <div class="flex items-start gap-4">
                    <span class="text-3xl shrink-0">{icon}</span>
                    <div class="min-w-0">
                      <span
                        class={`text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full ${badge}`}
                      >
                        {doc.type.toUpperCase()}
                      </span>
                      <h3 class="font-serif text-base font-bold text-chocolate leading-snug mt-2 group-hover:text-granate transition-colors">
                        {doc.title}
                      </h3>
                      {doc.description && (
                        <p class="text-sm text-marron/70 mt-2 line-clamp-2">
                          {doc.description}
                        </p>
                      )}
                      <span class="inline-flex items-center gap-1 text-xs font-medium text-oro mt-3 group-hover:gap-2 transition-all">
                        Ver documento{" "}
                        <span class="text-lg leading-none">&rarr;</span>
                      </span>
                    </div>
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <section class="py-16 bg-white">
    <div class="max-w-[1140px] mx-auto px-6">
      <div class="text-center mb-10">
        <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-3">
          Google Drive
        </span>
        <h2 class="font-serif text-xl md:text-2xl font-bold text-chocolate">
          Todos los archivos
        </h2>
        <p class="text-sm text-marron/60 mt-2 max-w-lg mx-auto">
          Explora la carpeta completa. Los archivos nuevos aparecen
          automáticamente.
        </p>
      </div>

      <div class="rounded-2xl overflow-hidden shadow-xl border border-gray-200 bg-white drive-embed hidden md:block">
        <iframe
          src={`https://drive.google.com/embeddedfolderview?id=${driveFolderId}#grid`}
          class="w-full h-[70vh] min-h-[500px] border-0"
          title="Google Drive — Biblioteca"
          loading="lazy"
        ></iframe>
      </div>
      <div class="block md:hidden">
        <div class="rounded-2xl shadow-xl border border-gray-200 bg-white overflow-hidden">
          <div class="bg-gradient-to-r from-chocolate to-chocolate/90 p-5">
            <div class="flex items-center gap-3">
              <span class="text-2xl">📂</span>
              <div>
                <p class="text-white font-bold text-sm">Google Drive</p>
                <p class="text-white/60 text-xs">Carpeta compartida</p>
              </div>
            </div>
          </div>
          <div class="p-5 text-center">
            <p class="text-sm text-marron/70 mb-4">
              Toca el boton para explorar todos los archivos en la app de Google Drive
            </p>
            <a
              href={`https://drive.google.com/drive/folders/${driveFolderId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-oro text-chocolate font-bold px-5 py-2.5 rounded-lg hover:bg-oro/90 transition-colors no-underline text-sm"
            >
              Abrir en Drive
              <span class="text-lg">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div
    id="doc-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative bg-white rounded-2xl shadow-2xl w-[95vw] max-w-5xl h-[85vh] flex flex-col overflow-hidden modal-panel">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 shrink-0">
        <h3 id="modal-title" class="font-serif text-lg font-bold text-chocolate truncate pr-4"></h3>
        <button
          id="modal-close"
          class="shrink-0 w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-marron"
          aria-label="Cerrar"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-5 h-5" stroke-width="2" stroke-linecap="round">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="flex-1 bg-gray-100">
        <iframe
          id="doc-iframe"
          class="w-full h-full border-0"
          title="Visor de documento"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</Layout>

<script>
  import gsap from "gsap";

  gsap.from(".document-card", {
    y: 40,
    opacity: 0,
    duration: 0.7,
    stagger: 0.08,
    ease: "power2.out",
    force3D: true,
  });

  gsap.from(".drive-embed", {
    y: 40,
    opacity: 0,
    duration: 0.8,
    ease: "power2.out",
    force3D: true,
  });

  const modal = document.getElementById("doc-modal")!;
  const modalTitle = document.getElementById("modal-title")!;
  const docIframe = document.getElementById("doc-iframe") as HTMLIFrameElement;
  const closeBtn = document.getElementById("modal-close")!;

  function openModal(title: string, fileId: string) {
    modalTitle.textContent = title;
    docIframe.src = `https://drive.google.com/file/d/${fileId}/preview`;
    modal.classList.remove("opacity-0", "pointer-events-none");
    document.body.style.overflow = "hidden";
    gsap.fromTo(
      ".modal-panel",
      { scale: 0.95, opacity: 0, y: 20 },
      { scale: 1, opacity: 1, y: 0, duration: 0.3, ease: "power2.out" },
    );
  }

  function closeModal() {
    modal.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
    docIframe.src = "";
  }

  document.querySelectorAll(".document-card").forEach((card) => {
    card.addEventListener("click", () => {
      const fileId = card.getAttribute("data-fileid")!;
      const title = card.getAttribute("data-title")!;
      openModal(title, fileId);
    });
  });

  closeBtn.addEventListener("click", closeModal);
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>
