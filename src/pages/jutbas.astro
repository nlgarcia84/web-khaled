---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import khaledJutba from "../assets/images/khaled_jutba.jpg";
import { getStream } from "../lib/sanity";
import { getLiveStream } from "../lib/youtube";

const stream = await getStream();
const channelId = stream?.channelId ?? "";
const chatEnabled = stream?.chatEnabled ?? true;
const live = channelId ? await getLiveStream(channelId) : null;
const isLive = live !== null;
const videoId = live?.videoId ?? "";
---

<Layout title="Jutbas en directo">
  <HeroSection
    image={khaledJutba}
    title={stream?.title || "Jutbas en directo"}
    description="Conéctate cada viernes a la transmisión en vivo de la jutba. Una oportunidad semanal para reflexionar, aprender y fortalecer el iman en comunidad."
    overlay="gradient-dark"
  >
    {
      isLive ? (
        <div slot="label" class="inline-flex items-center gap-2 bg-red-600/90 backdrop-blur-sm text-white text-sm font-bold px-5 py-2 rounded-full mb-6 live-badge">
          <span class="relative flex h-3 w-3">
            <span class="absolute inline-flex h-full w-full rounded-full bg-white opacity-75 live-ping" />
            <span class="relative inline-flex rounded-full h-3 w-3 bg-white" />
          </span>
          En directo ahora
        </div>
      ) : (
        <span slot="label" class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-4">
          Todos los viernes
        </span>
      )
    }
  </HeroSection>

  <section class="py-16 bg-gris-claro">
    <div class="max-w-[1200px] mx-auto px-6">
      {
        isLive ? (
          <div class="stream-live">
            <div class="text-center mb-10">
              <h2 class="font-serif text-xl md:text-2xl font-bold text-chocolate">
                {live.title}
              </h2>
              <div class="flex items-center justify-center gap-2 mt-3">
                <span class="relative flex h-2.5 w-2.5">
                  <span class="absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75 live-ping" />
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500" />
                </span>
                <span class="text-sm text-marron font-medium">
                  Transmitiendo en YouTube
                </span>
              </div>
            </div>

            {
              chatEnabled ? (
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 stream-grid">
                  <div class="lg:col-span-2">
                    <div class="relative w-full aspect-video bg-black rounded-2xl overflow-hidden shadow-2xl ring-2 ring-red-500/30 stream-video">
                      <iframe
                        class="absolute inset-0 w-full h-full"
                        src={`https://www.youtube.com/embed/${videoId}?autoplay=1`}
                        title="YouTube video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                      />
                    </div>
                  </div>
                  <div class="h-[500px] lg:h-full bg-white rounded-2xl overflow-hidden shadow-xl ring-1 ring-oro/30 stream-chat">
                    <div class="bg-chocolate text-white text-xs font-bold tracking-wider uppercase px-4 py-3 text-center">
                      <span class="relative inline-flex h-2 w-2 mr-2">
                        <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 live-ping" />
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400" />
                      </span>
                      Chat en vivo
                    </div>
                    <iframe
                      id="live-chat-frame"
                      class="w-full h-[calc(100%-40px)]"
                      title="Chat en vivo"
                      frameborder="0"
                      data-video-id={videoId}
                      allow="autoplay; clipboard-write"
                    />
                  </div>
                </div>
              ) : (
                <div class="max-w-4xl mx-auto">
                  <div class="relative w-full aspect-video bg-black rounded-2xl overflow-hidden shadow-2xl ring-2 ring-red-500/30 stream-video">
                    <iframe
                      class="absolute inset-0 w-full h-full"
                      src={`https://www.youtube.com/embed/${videoId}?autoplay=1`}
                      title="YouTube video player"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    />
                  </div>
                </div>
              )
            }
          </div>
        ) : (
          <div class="stream-offline text-center py-12 md:py-20">
            <div class="offline-indicator mb-10">
              <div class="connection-ring">
                <div class="connection-ring-inner">
                  <span class="text-5xl md:text-6xl">📡</span>
                </div>
              </div>
            </div>

            <h2 class="font-serif text-2xl md:text-3xl font-bold text-chocolate mb-4">
              Próxima jutba
            </h2>
            <p class="text-marron/70 text-lg max-w-xl mx-auto mb-10 leading-relaxed">
              No hay transmisión en este momento. La jutba se emite todos los
              viernes en directo. Vuelve el próximo viernes para conectarte a la
              transmisión.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-xl mx-auto">
              <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
                <span class="text-2xl">🕌</span>
                <p class="font-bold text-chocolate mt-3 text-sm">
                  Cada viernes
                </p>
                <p class="text-xs text-marron/60 mt-1">Jutba semanal</p>
              </div>
              <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
                <span class="text-2xl">📺</span>
                <p class="font-bold text-chocolate mt-3 text-sm">
                  YouTube Live
                </p>
                <p class="text-xs text-marron/60 mt-1">Transmisión en HD</p>
              </div>
              <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
                <span class="text-2xl">💬</span>
                <p class="font-bold text-chocolate mt-3 text-sm">
                  Chat en vivo
                </p>
                <p class="text-xs text-marron/60 mt-1">
                  Interactúa en tiempo real
                </p>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes live-ping {
    75%,
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .live-ping {
    animation: live-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .live-glow {
    animation: live-glow-pulse 2.5s ease-in-out infinite;
  }

  @keyframes live-glow-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.45);
    }
    50% {
      box-shadow: 0 0 0 18px rgba(220, 38, 38, 0);
    }
  }

  @keyframes connection-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(187, 148, 87, 0.3);
    }
    50% {
      box-shadow: 0 0 0 20px rgba(187, 148, 87, 0);
    }
  }

  @keyframes ring-rotate {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .connection-ring {
    width: 120px;
    height: 120px;
    margin: 0 auto;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    animation: connection-pulse 2.5s ease-in-out infinite;
  }

  .connection-ring::before {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px dashed rgba(187, 148, 87, 0.25);
    animation: ring-rotate 20s linear infinite;
  }

  .connection-ring-inner {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: white;
    border: 1px solid rgba(187, 148, 87, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  import gsap from "gsap";

  const chatFrame = document.getElementById("live-chat-frame");
  if (chatFrame) {
    const chatVideoId = chatFrame.dataset.videoId;
    chatFrame.src = `https://www.youtube.com/live_chat?v=${chatVideoId}&embed_domain=${window.location.hostname}&dark_theme=1`;
  }

  const liveVideoId = chatFrame
    ? chatFrame.dataset.videoId
    : document.querySelector<HTMLIFrameElement>("iframe.stream-video iframe")?.src.match(/embed\/([a-zA-Z0-9_-]+)/)?.[1] ?? null;

  let abort = false;
  window.addEventListener("astro:before-swap", () => (abort = true), { once: true });

  async function pollLiveStreamEnd() {
    if (abort) return;
    try {
      const res = await fetch(`/api/live-status?videoId=${liveVideoId}`);
      const data = await res.json();
      if (!data.isLive) {
        window.location.reload();
        return;
      }
    } catch {
      /* red temporal: reintentar */
    }
    setTimeout(pollLiveStreamEnd, 30000);
  }

  async function pollLiveStreamStart() {
    if (abort) return;
    try {
      const res = await fetch("/api/live-status");
      const data = await res.json();
      if (data.isLive) {
        window.location.reload();
        return;
      }
    } catch {
      /* red temporal: reintentar */
    }
    setTimeout(pollLiveStreamStart, 300000);
  }

  if (window.location.pathname === "/jutbas") {
    if (liveVideoId) {
      setTimeout(pollLiveStreamEnd, 30000);
    } else {
      setTimeout(pollLiveStreamStart, 300000);
    }
  }

  const streamLive = document.querySelector(".stream-live");
  if (streamLive) {
    gsap.from(".stream-live > *", {
      y: 40,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: "power2.out",
      force3D: true,
      delay: 0.3,
    });
  }

  const streamOffline = document.querySelector(".stream-offline");
  if (streamOffline) {
    gsap.from(".offline-indicator", {
      scale: 0.8,
      opacity: 0,
      duration: 0.8,
      ease: "power2.out",
      force3D: true,
    });
    gsap.from(".stream-offline h2, .stream-offline > p", {
      y: 30,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: "power2.out",
      force3D: true,
      delay: 0.2,
    });
    gsap.from(".stream-offline .grid > *", {
      y: 40,
      opacity: 0,
      duration: 0.7,
      stagger: 0.1,
      ease: "power2.out",
      force3D: true,
      delay: 0.5,
    });
  }
</script>
