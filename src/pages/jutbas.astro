---
import Layout from "../layouts/Layout.astro";
import khaledJutba from "../assets/images/khaled-jutba.jpg";
---
<Layout title="Jutbas">
    <section class="relative py-20 md:py-28 text-center overflow-hidden flex flex-col justify-center min-h-[calc(100svh-5rem)] md:min-h-[calc(100vh-5rem)]">
    <img
      src={khaledJutba.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-chocolate/85"></div>

    <div class="relative z-10 max-w-[800px] mx-auto px-6 hero-content">
      <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-4">
        Sobre el Autor
      </span>
      <h1 class="font-serif text-4xl md:text-6xl font-bold tracking-tight text-white mb-8 leading-tight">
        Sheij Khaled Huerta
      </h1>
      <p class="font-sans text-lg md:text-xl text-crema/80 font-light leading-relaxed">
        Un camino riguroso dedicado a la preservación, traducción y difusión
        de las ciencias tradicionales del Islam en lengua española.
      </p>
    </div>
  </section>
</Layout>