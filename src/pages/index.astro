---
import Camera from "lucide-static/dist/esm/icons/camera.mjs";
import MessageCircle from "lucide-static/dist/esm/icons/message-circle.mjs";
import Play from "lucide-static/dist/esm/icons/play.mjs";
import Send from "lucide-static/dist/esm/icons/send.mjs";
import MapPin from "lucide-static/dist/esm/icons/map-pin.mjs";
import Heart from "lucide-static/dist/esm/icons/heart.mjs";
import ArrowRight from "lucide-static/dist/esm/icons/arrow-right.mjs";
import khaledAlfombra from "../assets/images/khaled_alfombra.jpeg";
import khaledBoligrafo from "../assets/images/khaled_boligrafo.jpg";
import { events } from "../data/events";
import { getPosts } from "../lib/sanity";
import { getCampaign } from "../lib/sanity";
import { getLatestInstagramPost, getLatestTelegramPost } from "../lib/feeds";
import Layout from "../layouts/Layout.astro";

const posts = (await getPosts()).slice(0, 3);
const campaign = await getCampaign("alfombra");
const campaignPct = campaign?.goal > 0 ? Math.round(((campaign?.raised ?? 0) / campaign.goal) * 100) : 0;

const YT_CHANNEL_ID = "UCKSkh4JFzzyhqkAiocfq5-Q";
let latestVideo = { title: "Último video", id: "" };
try {
  const rss = await fetch(`https://www.youtube.com/feeds/videos.xml?channel_id=${YT_CHANNEL_ID}`);
  const xml = await rss.text();
  const entry = xml.match(/<entry>[\s\S]*?<\/entry>/);
  if (entry) {
    const title = entry[0].match(/<title>(.*?)<\/title>/)?.[1] || latestVideo.title;
    const videoId = entry[0].match(/<yt:videoId>(.*?)<\/yt:videoId>/)?.[1] || "";
    latestVideo = { title, id: videoId };
  }
} catch {}

const instagramPost = await getLatestInstagramPost("khaled.huerta");
const telegramPost = await getLatestTelegramPost("khaled_huerta");
---

<Layout title="Inicio">
  <section class="relative py-20 md:py-28 text-center overflow-hidden flex flex-col justify-center min-h-[70vh]">
    <img
      src={khaledAlfombra.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover hero-parallax"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-chocolate/80 via-chocolate/70 to-chocolate/85"></div>

    <div class="relative z-10 max-w-200 mx-auto px-6 hero-content">
      <p class="font-serif text-oro text-lg md:text-2xl italic font-semibold mb-6 leading-relaxed">
        "Los modales se aprenden antes que el conocimiento"
      </p>
      <h1 class="font-serif text-white text-3xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight mb-6">
        Difundiendo el mensaje del Islam en Español con rigor, sabiduría y cercanía
      </h1>
      <p class="text-crema/80 text-base md:text-lg font-light leading-relaxed max-w-2xl mx-auto mb-8">
        Un siervo de Allah que recuerda el camino de los justos predecesores.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/donar"
          class="inline-flex items-center justify-center gap-2 bg-oro text-chocolate font-semibold px-8 py-3 rounded-lg hover:bg-oro/90 transition-colors no-underline"
        >
          <span set:html={Heart} class="w-5 h-5" />
          Apoyar la causa
        </a>
        <a
          href="/biografia"
          class="inline-flex items-center justify-center gap-2 border border-white/30 text-white font-medium px-8 py-3 rounded-lg hover:bg-white/10 transition-colors no-underline"
        >
          Conocer más
          <span set:html={ArrowRight} class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 relative overflow-hidden">
    <img
      src={khaledBoligrafo.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-crema/90"></div>
    <div class="relative z-10 max-w-[1140px] mx-auto px-6">
      <div class="text-center mb-14">
        <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-3 section-label">
          Contenido
        </span>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-chocolate section-title">
          Últimos artículos
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-200 mx-auto blog-grid">
        {
          posts.map((post: any) => (
            <a
              href={`/blog/${post.slug.current}`}
              class="blog-card group bg-white border border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-oro/20 hover:-translate-y-0.5 transition-all duration-300 no-underline block"
            >
              <div class="w-8 h-0.5 bg-oro/60 rounded-full mb-4"></div>
              <time class="text-xs text-oro font-medium tracking-wide">
                {new Date(post.publishedAt).toLocaleDateString("es", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <h3 class="font-serif text-lg font-bold text-chocolate group-hover:text-granate transition-colors mt-2 leading-snug">
                {post.title}
              </h3>
              {post.excerpt && (
                <p class="text-sm text-marron/80 mt-2 leading-relaxed line-clamp-3">
                  {post.excerpt}
                </p>
              )}
              <span class="inline-flex items-center gap-1 text-sm font-medium text-oro mt-4 group-hover:gap-2 transition-all">
                Leer artículo <span set:html={ArrowRight} class="w-3.5 h-3.5" />
              </span>
            </a>
          ))
        }
      </div>
      <div class="text-center mt-12">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-chocolate font-medium border border-oro/30 px-6 py-3 rounded-lg hover:bg-oro/5 hover:border-oro transition-colors no-underline text-sm"
        >
          Ver todos los artículos <span set:html={ArrowRight} class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      <div class="text-center mb-14">
        <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-3 section-label">
          Redes
        </span>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-chocolate mb-3 section-title">
          Canales Oficiales
        </h2>
        <p class="text-sm text-marron font-medium">
          Síguenos en nuestras redes
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-200 mx-auto">
        <a
          href={latestVideo.id ? `https://youtu.be/${latestVideo.id}` : "https://www.youtube.com/@khaledhuerta"}
          target="_blank"
          rel="noopener noreferrer"
          class="social-card group bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-red-400/30 hover:-translate-y-0.5 transition-all duration-300 no-underline flex flex-col"
        >
          <div class="aspect-video bg-chocolate/5 overflow-hidden">
            {
              latestVideo.id ? (
                <img
                  src={`https://img.youtube.com/vi/${latestVideo.id}/maxresdefault.jpg`}
                  alt=""
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-red-600 via-red-500 to-rose-400">
                  <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center">
                    <span class="h-6 w-6 text-white" set:html={Play} />
                  </div>
                </div>
              )
            }
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <span class="text-[11px] font-semibold tracking-wide text-red-600 bg-red-50 px-2.5 py-0.5 rounded-full self-start">YouTube</span>
            <p class="text-[11px] text-marron/60 mt-2 font-medium tracking-wide uppercase">Último video</p>
            <h3 class="font-serif text-sm font-bold text-chocolate leading-snug line-clamp-2 group-hover:text-granate transition-colors">
              {latestVideo.title}
            </h3>
            <span class="inline-flex items-center gap-1 text-xs font-medium text-red-600 mt-3 group-hover:gap-2 transition-all">
              Ver video <span set:html={ArrowRight} class="w-3 h-3" />
            </span>
          </div>
        </a>

        <a
          href={instagramPost?.url || "https://www.instagram.com/khaled.huerta/"}
          target="_blank"
          rel="noopener noreferrer"
          class="social-card group bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-pink-400/30 hover:-translate-y-0.5 transition-all duration-300 no-underline flex flex-col"
        >
          <div class="aspect-video bg-chocolate/5 overflow-hidden">
            {
              instagramPost?.thumbnail ? (
                <img
                  src={instagramPost.thumbnail}
                  alt=""
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-purple-600 via-pink-500 to-yellow-500">
                  <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center">
                    <span class="text-white font-bold text-xl" style="font-family: serif;">IG</span>
                  </div>
                </div>
              )
            }
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <span class="text-[11px] font-semibold tracking-wide text-pink-600 bg-pink-50 px-2.5 py-0.5 rounded-full self-start">Instagram</span>
            <p class="text-[11px] text-marron/60 mt-2 font-medium tracking-wide uppercase">Última publicación</p>
            <h3 class="font-serif text-sm font-bold text-chocolate leading-snug line-clamp-2 group-hover:text-granate transition-colors">
              {instagramPost?.caption || "@khaled.huerta"}
            </h3>
            <span class="inline-flex items-center gap-1 text-xs font-medium text-pink-600 mt-3 group-hover:gap-2 transition-all">
              Ver en Instagram <span set:html={ArrowRight} class="w-3 h-3" />
            </span>
          </div>
        </a>

        <a
          href="https://www.facebook.com/khaled.huerta/"
          target="_blank"
          rel="noopener noreferrer"
          class="social-card group bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-blue-400/30 hover:-translate-y-0.5 transition-all duration-300 no-underline flex flex-col"
        >
          <div class="aspect-video bg-chocolate/5 overflow-hidden">
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-700 via-blue-500 to-sky-400">
              <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center">
                <span class="text-white font-bold text-2xl" style="font-family: serif;">f</span>
              </div>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <span class="text-[11px] font-semibold tracking-wide text-blue-600 bg-blue-50 px-2.5 py-0.5 rounded-full self-start">Facebook</span>
            <p class="text-[11px] text-marron/60 mt-2 font-medium tracking-wide uppercase">Red social</p>
            <h3 class="font-serif text-sm font-bold text-chocolate leading-snug line-clamp-2 group-hover:text-granate transition-colors">
              Khaled Huerta
            </h3>
            <span class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 mt-3 group-hover:gap-2 transition-all">
              Ver página <span set:html={ArrowRight} class="w-3 h-3" />
            </span>
          </div>
        </a>

        <a
          href={telegramPost?.url || "https://t.me/khaled_huerta"}
          target="_blank"
          rel="noopener noreferrer"
          class="social-card group bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-sky-400/30 hover:-translate-y-0.5 transition-all duration-300 no-underline flex flex-col"
        >
          <div class="aspect-video bg-chocolate/5 overflow-hidden">
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-sky-600 via-cyan-500 to-teal-400">
              <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center">
                <span class="text-white font-bold text-lg" style="font-family: serif;">TG</span>
              </div>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <span class="text-[11px] font-semibold tracking-wide text-sky-600 bg-sky-50 px-2.5 py-0.5 rounded-full self-start">Telegram</span>
            <p class="text-[11px] text-marron/60 mt-2 font-medium tracking-wide uppercase">Mensajes</p>
            <h3 class="font-serif text-sm font-bold text-chocolate leading-snug line-clamp-2 group-hover:text-granate transition-colors">
              {telegramPost?.text || "@khaled_huerta"}
            </h3>
            <span class="inline-flex items-center gap-1 text-xs font-medium text-sky-600 mt-3 group-hover:gap-2 transition-all">
              {telegramPost ? "Abrir en Telegram" : "Enviar mensaje"} <span set:html={ArrowRight} class="w-3 h-3" />
            </span>
          </div>
        </a>

        <a
          href="https://www.tiktok.com/@khaledhuerta"
          target="_blank"
          rel="noopener noreferrer"
          class="social-card group bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-gray-900/30 hover:-translate-y-0.5 transition-all duration-300 no-underline flex flex-col"
        >
          <div class="aspect-video bg-chocolate/5 overflow-hidden">
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-900 via-gray-800 to-gray-700">
              <div class="w-12 h-12 rounded-full bg-white/15 flex items-center justify-center">
                <span class="text-white font-bold text-xl">♪</span>
              </div>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <span class="text-[11px] font-semibold tracking-wide text-gray-900 bg-gray-100 px-2.5 py-0.5 rounded-full self-start">TikTok</span>
            <p class="text-[11px] text-marron/60 mt-2 font-medium tracking-wide uppercase">Red social</p>
            <h3 class="font-serif text-sm font-bold text-chocolate leading-snug line-clamp-2 group-hover:text-granate transition-colors">
              @khaledhuerta
            </h3>
            <span class="inline-flex items-center gap-1 text-xs font-medium text-gray-900 mt-3 group-hover:gap-2 transition-all">
              Ver perfil <span set:html={ArrowRight} class="w-3 h-3" />
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      <div class="text-center mb-14">
        <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-3 section-label">
          Agenda
        </span>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-chocolate mb-3 section-title">
          Próximos eventos
        </h2>
        <p class="text-sm text-marron font-medium">
          Estos son los siguientes eventos programados
        </p>
      </div>

      <div class="max-w-2xl mx-auto space-y-4 events-list">
        {
          events.map((event) => {
            const date = new Date(event.date);
            const day = date.getDate();
            const month = date.toLocaleDateString("es", { month: "short" });
            const flag = event.Lugar.includes("México") ? "🇲🇽" : event.Lugar.includes("Argentina") ? "🇦🇷" : event.Lugar.includes("Chile") ? "🇨🇱" : "";
            return (
              <div class="event-card group bg-white border border-gray-100 rounded-xl p-5 shadow-sm hover:shadow-md hover:border-oro/20 hover:-translate-y-0.5 transition-all duration-300 flex items-center gap-5">
                <div class="w-14 h-14 bg-oro/10 rounded-xl flex flex-col items-center justify-center shrink-0">
                  <span class="text-lg font-bold text-oro leading-none">{day}</span>
                  <span class="text-[10px] font-semibold text-oro uppercase tracking-wide">{month}</span>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-serif text-base font-bold text-chocolate leading-snug">{event.title}</h3>
                  <div class="flex items-center gap-1.5 mt-1">
                    <span class="text-sm shrink-0">{flag}</span>
                    <p class="text-sm text-marron/70 truncate">{event.Lugar}</p>
                  </div>
                </div>
                <span class="text-marron/30 group-hover:text-oro group-hover:translate-x-1 transition-all font-bold text-lg shrink-0">&rarr;</span>
              </div>
            )
          })
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  import gsap from "gsap";

  function revealOnScroll(selector, opts = {}) {
    const { stagger = 0.1, from = "bottom", distance = 60 } = opts;
    const els = document.querySelectorAll(selector);
    if (!els.length) return;
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (!visible.length) return;
        const targets = visible.map((e) => e.target);
        const vars = { opacity: 0, duration: 1.2, stagger, ease: "power4.out", filter: "blur(6px)" };
        if (from === "bottom") {
          gsap.fromTo(targets, { y: distance, ...vars }, { y: 0, opacity: 1, filter: "blur(0px)", duration: 1.2, stagger, ease: "power4.out" });
        } else if (from === "center") {
          gsap.set(targets, { transformOrigin: "center center", filter: "blur(6px)" });
          gsap.fromTo(targets, { opacity: 0, scale: 0.4, y: 40, rotation: -3 }, { opacity: 1, scale: 1, y: 0, rotation: 0, filter: "blur(0px)", duration: 1.2, stagger, ease: "power4.out" });
        } else if (from === "side") {
          targets.forEach((t, i) => {
            const dir = i % 2 === 0 ? -1 : 1;
            gsap.fromTo(t, { x: dir * 80, opacity: 0, filter: "blur(6px)" }, { x: 0, opacity: 1, filter: "blur(0px)", duration: 1.2, ease: "power4.out", delay: i * stagger });
          });
        }
        targets.forEach((t) => observer.unobserve(t));
      },
      { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
    );
    els.forEach((el) => observer.observe(el));
  }

  gsap.from(".hero-content > *", {
    y: 80,
    opacity: 0,
    filter: "blur(10px)",
    duration: 1.2,
    stagger: 0.15,
    ease: "power4.out",
  });

  gsap.set(".hero-parallax", { scale: 1 });

  revealOnScroll(".blog-card", { from: "center", stagger: 0.1 });
  revealOnScroll(".social-card", { from: "center", stagger: 0.08 });
  revealOnScroll(".event-card", { from: "side", stagger: 0.08 });
</script>
