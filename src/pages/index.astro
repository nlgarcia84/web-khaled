      <div class="relative max-w-4xl mx-auto">
        <div class="w-full lg:w-7/12 mx-auto lg:mx-0 space-y-4 events-list relative z-30">
          {
            events.map((event, i) => {
              const date = new Date(event.date);
              const day = date.getDate();
              const month = date.toLocaleDateString("es", { month: "short" });
              const flag = event.Lugar.includes("México")
                ? "🇲🇽"
                : event.Lugar.includes("Argentina")
                  ? "🇦🇷"
                  : event.Lugar.includes("Chile")
                    ? "🇨🇱"
                    : "";
              return (
                <div
                  class={
                    "event-card group bg-white border border-gray-100 rounded-xl p-5 shadow-sm hover:shadow-md hover:border-oro/20 hover:-translate-y-0.5 transition-all duration-300 flex items-center gap-5" +
                    (i === 0 ? " nearest-event" : " opacity-50 grayscale")
