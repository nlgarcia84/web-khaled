</Layout>

<script>
  import gsap from "gsap";

  let scrollTimeout;
  let isScrolling = false;
  document.addEventListener(
    "scroll",
    () => {
      if (!isScrolling) isScrolling = true;
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        isScrolling = false;
      }, 150);
    },
    { passive: true },
  );

  function revealOnScroll(selector, opts = {}) {
    const { stagger = 0.1, from = "bottom", distance = 40 } = opts;
    const els = document.querySelectorAll(selector);
    if (!els.length) return;
    const observer = new IntersectionObserver(
      (entries) => {
        if (isScrolling) return;
        const visible = entries.filter((e) => e.isIntersecting);
        if (!visible.length) return;
        const targets = visible.map((e) => e.target);
        const base = {
          duration: 0.8,
          ease: "power2.out",
          overwrite: "auto",
          force3D: true,
        };
        if (from === "bottom") {
          gsap.fromTo(
            targets,
            { y: distance, opacity: 0 },
            { y: 0, opacity: 1, stagger, ...base },
          );
        } else if (from === "center") {
          gsap.set(targets, { transformOrigin: "center center" });
          gsap.fromTo(
            targets,
            { opacity: 0, scale: 0.92, y: 16 },
            { opacity: 1, scale: 1, y: 0, stagger, ...base },
          );
        } else if (from === "side") {
          targets.forEach((t, i) => {
            const dir = i % 2 === 0 ? -1 : 1;
            gsap.fromTo(
              t,
              { x: dir * 30, opacity: 0 },
              { x: 0, opacity: 1, delay: i * stagger, ...base },
            );
          });
        }
        targets.forEach((t) => observer.unobserve(t));
      },
      { threshold: 0.2 },
    );
    els.forEach((el) => observer.observe(el));
  }

  gsap.set(".hero-parallax", { scale: 1 });

  revealOnScroll(".section-header > *", { stagger: 0.1, distance: 30 });
  revealOnScroll(".blog-card", { from: "center", stagger: 0.08 });
  revealOnScroll(".social-card", { from: "center", stagger: 0.08 });
  revealOnScroll(".event-card", { from: "side", stagger: 0.06 });

  document.querySelectorAll(".event-card").forEach((card, i) => {
    if (i > 0) card.style.opacity = "0.5";
  });

  const nearest = document.querySelector(".nearest-event");
  if (nearest) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          gsap.fromTo(
            nearest,
            { scale: 0.95, opacity: 0, force3D: true },
            {
              scale: 1,
              opacity: 1,
              duration: 0.8,
              ease: "power2.out",
              force3D: true,
            },
          );
          observer.unobserve(nearest);
        }
      },
      { threshold: 0.2 },
    );
    observer.observe(nearest);
  }
</script>
