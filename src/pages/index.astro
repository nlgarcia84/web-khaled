---
import Play from "lucide-static/dist/esm/icons/play.mjs";
import Camera from "lucide-static/dist/esm/icons/camera.mjs";
import Music from "lucide-static/dist/esm/icons/music.mjs";
import Send from "lucide-static/dist/esm/icons/send.mjs";
import Users from "lucide-static/dist/esm/icons/users.mjs";

const Heart = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
const ArrowRight = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;
import khaledMaktaba from "../assets/images/khaled_maktaba.jpg";
import khaledBoligrafo from "../assets/images/khaled_boligrafo.jpg";
import khaledLibreta from "../assets/images/khaled_libreta.png";
import { events } from "../data/events";
import { getPosts } from "../lib/sanity";
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import PostCard from "../components/PostCard.astro";
import { Image } from "astro:assets";

const posts = (await getPosts()).slice(0, 3);

const YT_CHANNEL_URL = "https://www.youtube.com/@khaledhuerta";

const socials = [
  {
    href: YT_CHANNEL_URL,
    icon: Play,
    name: "YouTube",
    type: "Canal",
    handle: "Khaled Huerta",
    cta: "Ver canal",
  },
  {
    href: "https://www.instagram.com/khaled.huerta/",
    icon: Camera,
    name: "Instagram",
    type: "Perfil",
    handle: "@khaled.huerta",
    cta: "Ver perfil",
  },
  {
    href: "https://www.facebook.com/khaled.huerta/",
    icon: Users,
    name: "Facebook",
    type: "Red social",
    handle: "Khaled Huerta",
    cta: "Ver página",
  },
  {
    href: "https://t.me/khaled_huerta",
    icon: Send,
    name: "Telegram",
    type: "Canal",
    handle: "@khaled_huerta",
    cta: "Abrir canal",
  },
  {
    href: "https://www.tiktok.com/@khaledhuerta",
    icon: Music,
    name: "TikTok",
    type: "Red social",
    handle: "@khaledhuerta",
    cta: "Ver perfil",
  },
];
---

<Layout
  title="Inicio"
  description="Difundo el mensaje del Islam en español con rigor, sabiduría y cercanía. Jutbas en directo cada viernes, reflexiones y más."
>
  <HeroSection
    image={khaledMaktaba}
    quote='"Los modales se aprenden antes que el conocimiento"'
    title="Difundiendo el mensaje del Islam en Español con rigor, sabiduría y cercanía"
    titleAccent="Islam"
    description="Un siervo de Allah que recuerda el camino de los justos predecesores."
    overlay="solid"
    maxWidth="800px"
    imageClass="hero-parallax"
  >
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/donar"
        class="inline-flex items-center justify-center gap-2 h-12 bg-oro text-chocolate font-semibold px-8 rounded-lg shadow-lg shadow-oro/20 hover:bg-oro/90 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-oro focus-visible:ring-offset-2 focus-visible:ring-offset-chocolate transition-all duration-200 no-underline"
      >
        <span set:html={Heart} class="w-5 h-5" />
        Apoyar la causa
      </a>
      <a
        href="/biografia"
        class="inline-flex items-center justify-center gap-2 h-12 border border-white/25 text-white font-medium px-8 rounded-lg hover:bg-white/10 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-oro focus-visible:ring-offset-2 focus-visible:ring-offset-chocolate transition-all duration-200 no-underline"
      >
        Conocer más
        <span set:html={ArrowRight} class="w-5 h-5" />
      </a>
    </div>
  </HeroSection>

  <section
    class="py-24 relative overflow-hidden bg-gradient-to-b from-[#fdfcf9] via-[#fdfcf9] to-[#f8f9fa]"
  >
    <Image
      src={khaledBoligrafo}
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-10 [mask-image:linear-gradient(to_bottom,black,black_90%,transparent)]"
      aria-hidden="true"
      loading="lazy"
    />
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,transparent_60%,#fdfcf9_88%)] [mask-image:linear-gradient(to_bottom,black,black_90%,transparent)]"
    >
    </div>
    <div class="relative z-10 max-w-[1140px] mx-auto px-6">
      <div class="text-center mb-14 section-header">
        <span
          class="font-sans text-xs font-bold tracking-[0.2em] text-marron uppercase block mb-3 section-label"
        >
          Contenido
        </span>
        <h2
          class="font-serif text-3xl md:text-4xl font-bold text-chocolate section-title"
        >
          Últimos artículos
        </h2>
      </div>
      <div
        class="blog-marquee relative overflow-hidden touch-pan-y cursor-grab active:cursor-grabbing [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
      >
        <div class="blog-marquee__track flex w-max will-change-transform">
          <div class="flex shrink-0">
            {posts.map((post: any) => <PostCard post={post} />)}
          </div>
          <div class="flex shrink-0" aria-hidden="true">
            {posts.map((post: any) => <PostCard post={post} />)}
          </div>
        </div>
      </div>
      <div class="text-center mt-12">
        <a
          href="/blog"
          class="group inline-flex h-12 items-center justify-center gap-3 rounded-full border border-oro/40 bg-oro px-7 text-sm font-semibold tracking-wide text-chocolate shadow-lg shadow-oro/25 no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-oro/90 hover:shadow-xl hover:shadow-oro/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-oro focus-visible:ring-offset-2 focus-visible:ring-offset-gris-claro"
        >
          Ver todos los artículos
          <span
            class="flex h-7 w-7 items-center justify-center rounded-full bg-chocolate/10 text-chocolate transition-all duration-300 group-hover:translate-x-0.5 group-hover:bg-chocolate group-hover:text-oro"
          >
            <span
              class="flex h-4 w-4 items-center justify-center [&>svg]:h-4 [&>svg]:w-4"
              set:html={ArrowRight}
            />
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      <div class="text-center mb-14 section-header">
        <span
          class="font-sans text-xs font-bold tracking-[0.2em] text-marron uppercase block mb-3 section-label"
        >
          Redes
        </span>
        <h2
          class="font-serif text-3xl md:text-4xl font-bold text-chocolate mb-3 section-title"
        >
          Canales Oficiales
        </h2>
        <p class="text-sm text-marron font-medium">
          Sígueme en mis redes sociales, contenido actualizado diariamente
        </p>
      </div>

      <div
        class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5 max-w-6xl mx-auto"
      >
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-card group relative flex flex-col overflow-hidden rounded-2xl border border-oro/20 bg-white/70 backdrop-blur-xl shadow-sm shadow-black/5 no-underline transition-all duration-300 hover:-translate-y-1 hover:border-oro/50 hover:bg-white/90 hover:shadow-xl hover:shadow-oro/10"
            >
              <div class="pointer-events-none absolute inset-x-5 top-0 h-px bg-gradient-to-r from-transparent via-oro/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
              <div class="relative flex h-28 items-center justify-center overflow-hidden bg-gradient-to-br from-chocolate via-[#3b2413] to-[#1d0f05]">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_130%,rgba(187,148,87,0.35),transparent_60%)]" />
                <div class="relative flex h-12 w-12 items-center justify-center rounded-2xl border border-oro/30 bg-white/5 text-oro backdrop-blur-sm transition-transform duration-300 group-hover:scale-110">
                  <span class="h-6 w-6" set:html={social.icon} />
                </div>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <span class="inline-flex self-start rounded-full border border-oro/30 bg-oro/10 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.15em] text-marron">
                  {social.name}
                </span>
                <p class="mt-2 text-[11px] font-medium uppercase tracking-wide text-marron/70">
                  {social.type}
                </p>
                <h3 class="font-serif text-sm font-bold leading-snug text-chocolate transition-colors line-clamp-2 group-hover:text-granate">
                  {social.handle}
                </h3>
                <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-marron transition-colors group-hover:text-granate">
                  {social.cta}
                  <span
                    class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5"
                    set:html={ArrowRight}
                  />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    events.length > 0 && (
      <section class="py-24 bg-gris-claro relative">
        <div class="relative z-10 max-w-[1140px] mx-auto px-6">
          <div class="relative z-30 text-center mb-40 section-header">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-marron uppercase block mb-3 section-label">
              Agenda
            </span>
            <h2 class="font-serif text-3xl md:text-4xl font-bold text-chocolate mb-3 section-title">
              Próximos eventos
            </h2>
            <p class="text-sm text-marron font-medium">
              Estos son los siguientes eventos programados
            </p>
          </div>

          <div class="relative max-w-4xl mx-auto pt-8 pb-16 flex items-center">
            <div class="w-full lg:w-7/12 mx-auto lg:mx-0 space-y-4 events-list relative z-10">
              {events.map((event, i) => {
                const date = new Date(event.date);
                const day = date.getDate();
                const month = date.toLocaleDateString("es", { month: "short" });
                const flag = event.Lugar.includes("México")
                  ? "🇲🇽"
                  : event.Lugar.includes("Argentina")
                    ? "🇦🇷"
                    : event.Lugar.includes("Chile")
                      ? "🇨🇱"
                      : "";
                return (
                  <div
                    class={
                      "event-card group bg-white border border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-oro/20 hover:-translate-y-0.5 transition-all duration-300 flex items-center gap-6" +
                      (i === 0 ? " nearest-event" : " grayscale")
                    }
                  >
                    <div class="w-16 h-16 bg-oro/10 rounded-xl flex flex-col items-center justify-center shrink-0">
                      <span class="text-3xl font-bold text-marron leading-none">
                        {day}
                      </span>
                      <span class="text-sm font-semibold text-marron uppercase tracking-wide">
                        {month}
                      </span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="font-serif text-xl font-bold text-chocolate leading-snug">
                        {event.title}
                      </h3>
                      <div class="flex items-center gap-1.5 mt-1">
                        <span class="text-base shrink-0">{flag}</span>
                        <p class="text-base text-marron truncate">
                          {event.Lugar}
                        </p>
                      </div>
                    </div>
                    <span class="text-marron/70 group-hover:text-oro group-hover:translate-x-1 transition-all font-bold text-xl shrink-0">
                      &rarr;
                    </span>
                  </div>
                );
              })}
            </div>

            <div
              class="hidden lg:block absolute right-0 w-7/12 z-20"
              style="top: -50%;"
            >
              <Image
                src={khaledLibreta}
                alt=""
                class="w-full h-auto pl-10"
                aria-hidden="true"
                widths={[320, 400, 480, 640]}
                sizes="(min-width: 1024px) 483px, 100vw"
              />
            </div>
          </div>
        </div>
      </section>
    )
  }
</Layout>

<script>
  import gsap from "gsap";
  import { revealOnScroll } from "../lib/scroll-reveal";

  gsap.set(".hero-parallax", { scale: 1 });

  revealOnScroll(".section-header > *", { stagger: 0.1, distance: 30 });
  revealOnScroll(".social-card", { from: "center", stagger: 0.08 });
  revealOnScroll(".event-card", { from: "side", stagger: 0.06 });

  let marqueeRaf = 0;
  let marqueeAbort: AbortController | null = null;
  const initMarquee = () => {
    const marquee = document.querySelector(".blog-marquee");
    const track = marquee?.querySelector(".blog-marquee__track");
    if (!marquee || !track) return;

    cancelAnimationFrame(marqueeRaf);
    marqueeAbort?.abort();
    const abort = new AbortController();
    marqueeAbort = abort;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const SPEED = 30; // px/s
    let x = 0;
    let isDown = false;
    let dragged = false;
    let startX = 0;
    let startXPos = 0;
    let lastTime = 0;
    let max = 0;

    const setX = (v: number) => {
      x = v;
      track.style.transform = `translate3d(${-x}px, 0, 0)`;
    };
    const computeMax = () => {
      max = Math.max(0, track.scrollWidth - marquee.clientWidth);
    };
    computeMax();
    window.addEventListener("resize", computeMax, { signal: abort.signal });

    marquee.querySelectorAll("a").forEach((a) => {
      a.setAttribute("draggable", "false");
    });
    marquee.addEventListener("dragstart", (e) => e.preventDefault());

    marquee.addEventListener("pointerdown", (e) => {
      isDown = true;
      dragged = false;
      startX = e.clientX;
      startXPos = x;
      marquee.classList.add("dragging");
    });

    window.addEventListener(
      "pointermove",
      (e) => {
        if (!isDown) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 4) dragged = true;
        if (dragged) setX(Math.min(Math.max(startXPos - dx, 0), max));
      },
      { signal: abort.signal },
    );

    const endDrag = () => {
      isDown = false;
      marquee.classList.remove("dragging");
    };
    window.addEventListener("pointerup", endDrag, { signal: abort.signal });
    window.addEventListener("pointercancel", endDrag, { signal: abort.signal });

    marquee.addEventListener(
      "click",
      (e) => {
        if (dragged) {
          e.preventDefault();
          e.stopPropagation();
          dragged = false;
        }
      },
      true,
    );

    function tick(time) {
      if (!reducedMotion && !isDown && !document.hidden) {
        const dt = lastTime ? (time - lastTime) / 1000 : 0;
        if (max > 0) {
          x += dt * SPEED;
          if (x >= max) x = 0;
          track.style.transform = `translate3d(${-x}px, 0, 0)`;
        }
      }
      lastTime = time;
      marqueeRaf = requestAnimationFrame(tick);
    }
    marqueeRaf = requestAnimationFrame(tick);
  };

  initMarquee();
  if (!(window as any).__marqueeInit) {
    (window as any).__marqueeInit = true;
    document.addEventListener("astro:after-swap", initMarquee);
  }

  const nearest = document.querySelector(".nearest-event");
  if (nearest) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          gsap.fromTo(
            nearest,
            { scale: 0.95, opacity: 0, force3D: true },
            {
              scale: 1,
              opacity: 1,
              duration: 0.5,
              ease: "power1.out",
              force3D: true,
            },
          );
          observer.unobserve(nearest);
        }
      },
      { threshold: 0.2 },
    );
    observer.observe(nearest);
  }
</script>

<style is:global>
  .blog-marquee {
    scrollbar-width: none;
    -ms-overflow-style: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .blog-marquee::-webkit-scrollbar {
    display: none;
  }
</style>
