---
import Camera from "lucide-static/dist/esm/icons/camera.mjs";
import MessageCircle from "lucide-static/dist/esm/icons/message-circle.mjs";
import Play from "lucide-static/dist/esm/icons/play.mjs";
import Send from "lucide-static/dist/esm/icons/send.mjs";
import MapPin from "lucide-static/dist/esm/icons/map-pin.mjs";
import Heart from "lucide-static/dist/esm/icons/heart.mjs";
import ArrowRight from "lucide-static/dist/esm/icons/arrow-right.mjs";
import khaledAlfombra from "../assets/images/khaled_alfombra.jpeg";
import khaledBoligrafo from "../assets/images/khaled_boligrafo.jpg";
import khaledLibreta from "../assets/images/khaled_libreta.png";
import { events } from "../data/events";
import { getPosts } from "../lib/sanity";
import { getCampaign } from "../lib/sanity";
import { getLatestInstagramPost, getLatestTelegramPost } from "../lib/feeds";
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";

const posts = (await getPosts()).slice(0, 3);
const campaign = await getCampaign("alfombra");
const campaignPct =
  campaign?.goal > 0
    ? Math.round(((campaign?.raised ?? 0) / campaign.goal) * 100)
    : 0;

const YT_CHANNEL_ID = "UCKSkh4JFzzyhqkAiocfq5-Q";
let latestVideo = { title: "Último video", id: "" };
try {
  const rss = await fetch(
    `https://www.youtube.com/feeds/videos.xml?channel_id=${YT_CHANNEL_ID}`,
  );
  const xml = await rss.text();
  const entry = xml.match(/<entry>[\s\S]*?<\/entry>/);
  if (entry) {
    const title =
      entry[0].match(/<title>(.*?)<\/title>/)?.[1] || latestVideo.title;
    const videoId =
      entry[0].match(/<yt:videoId>(.*?)<\/yt:videoId>/)?.[1] || "";
    latestVideo = { title, id: videoId };
  }
} catch {}

const instagramPost = await getLatestInstagramPost("khaled.huerta");
const telegramPost = await getLatestTelegramPost("khaled_huerta");
---

<Layout title="Inicio">
  <HeroSection
    image={khaledAlfombra}
    quote='"Los modales se aprenden antes que el conocimiento"'
    title="Difundiendo el mensaje del Islam en Español con rigor, sabiduría y cercanía"
    description="Un siervo de Allah que recuerda el camino de los justos predecesores."
    overlay="gradient"
    maxWidth="800px"
    imageClass="hero-parallax"
  >
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/donar"
        class="inline-flex items-center justify-center gap-2 bg-oro text-chocolate font-semibold px-8 py-3 rounded-lg hover:bg-oro/90 transition-colors no-underline"
      >
        <span set:html={Heart} class="w-5 h-5" />
        Apoyar la causa
      </a>
      <a
        href="/biografia"
        class="inline-flex items-center justify-center gap-2 border border-white/30 text-white font-medium px-8 py-3 rounded-lg hover:bg-white/10 transition-colors no-underline"
      >
        Conocer más
        <span set:html={ArrowRight} class="w-4 h-4" />
      </a>
    </div>
  </HeroSection>

  <section
    class="py-24 relative overflow-hidden bg-gradient-to-b from-[#fdfcf9] via-[#fdfcf9] to-[#f8f9fa]"
  >
    <img
      src={khaledBoligrafo.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-10 [mask-image:linear-gradient(to_bottom,black,black_90%,transparent)]"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,transparent_60%,#fdfcf9_88%)] [mask-image:linear-gradient(to_bottom,black,black_90%,transparent)]"
    >
    </div>
    <div class="relative z-10 max-w-[1140px] mx-auto px-6">
      <div class="text-center mb-14 section-header">
        <span
          class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-3 section-label"
        >
          Contenido
        </span>
        <h2
          class="font-serif text-3xl md:text-4xl font-bold text-chocolate section-title"
        >
          Últimos artículos
        </h2>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-200 mx-auto blog-grid"
      >
        {
          posts.map((post: any) => (
            <a
              href={`/blog/${post.slug.current}`}
              class="blog-card group bg-white border border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-oro/20 hover:-translate-y-0.5 transition-all duration-300 no-underline block"
            >
              <div class="w-8 h-0.5 bg-oro/60 rounded-full mb-4" />
              <time class="text-xs text-oro font-medium tracking-wide">
