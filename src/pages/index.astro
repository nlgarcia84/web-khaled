        <a
          href="https://www.tiktok.com/@khaledhuerta"
          target="_blank"
          rel="noopener noreferrer"
          class="social-card group bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-gray-900/30 hover:-translate-y-0.5 transition-all duration-300 no-underline flex flex-col"
        >
          <div class="aspect-video bg-chocolate/5 overflow-hidden">
            <div
              class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-900 via-gray-800 to-gray-700"
            >
