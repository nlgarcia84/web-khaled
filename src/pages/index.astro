---
import Camera from "lucide-static/dist/esm/icons/camera.mjs";
import MessageCircle from "lucide-static/dist/esm/icons/message-circle.mjs";
import Play from "lucide-static/dist/esm/icons/play.mjs";
import Send from "lucide-static/dist/esm/icons/send.mjs";
import khaledAlfombra from "../assets/images/khaled_alfombra.jpeg";
import { events } from "../data/events";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Inicio">
  <section class="relative py-20 md:py-28 text-center overflow-hidden flex flex-col justify-center">
    <img
      src={khaledAlfombra.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-chocolate/70"></div>
    <div class="relative z-10 max-w-200 mx-auto px-6">
      <p
        class="font-serif text-oro text-lg md:text-xl italic font-semibold mb-4"
      >
        "Los modales se aprenden antes que el conocimiento"
      </p>

      <h1
        class="font-serif text-white text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-4"
      >
        Difundiendo el mensaje del Islam en Español con rigor, sabiduría y
        cercanía
      </h1>

      <p
        class="text-crema/80 text-base md:text-lg font-light leading-relaxed max-w-2xl mx-auto"
      >
        Un siervo de Allah que recuerda el camino de los justos predecesores.
      </p>
    </div>
  </section>

  <section class="py-20 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6 mb-12">
      <div class="text-center mb-12">
        <h2
          class="font-serif text-2xl md:text-3xl font-bold text-chocolate mb-3"
        >
          Canales Oficiales y Redes
        </h2>
        <p class="text-sm text-marron font-medium tracking-wide uppercase">
          Accede al contenido y mantente comunicado
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-200 mx-auto">
        <a
          href="https://www.youtube.com/channel/UCKSkh4JFzzyhqkAiocfq5-Q"
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white border border-gray-100 p-6 rounded-xl shadow-sm hover:shadow-md hover:border-oro/30 transition-all duration-300 flex items-center justify-between no-underline"
        >
          <div class="flex items-center gap-4">
            <span class="h-8 w-8 text-chocolate shrink-0" set:html={Play} />
            <div>
              <h3
                class="font-serif text-lg font-bold text-chocolate group-hover:text-granate transition-colors"
              >
                Canal de YouTube
              </h3>
              <p class="text-sm text-marron mt-1">
                Conferencias, directos y clases virtuales.
              </p>
            </div>
          </div>
          <span
            class="text-oro group-hover:translate-x-1 transition-transform font-bold text-lg"
            >&rarr;</span
          >
        </a>

        <a
          href="https://t.me"
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white border border-gray-100 p-6 rounded-xl shadow-sm hover:shadow-md hover:border-oro/30 transition-all duration-300 flex items-center justify-between no-underline"
        >
          <div class="flex items-center gap-4">
            <span class="h-8 w-8 text-chocolate shrink-0" set:html={Send} />
            <div>
              <h3
                class="font-serif text-lg font-bold text-chocolate group-hover:text-granate transition-colors"
              >
                Canal de Telegram
              </h3>
              <p class="text-sm text-marron mt-1">
                Recordatorios cotidianos y anuncios directos.
              </p>
            </div>
          </div>
          <span
            class="text-oro group-hover:translate-x-1 transition-transform font-bold text-lg"
            >&rarr;</span
          >
        </a>

        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white border border-gray-100 p-6 rounded-xl shadow-sm hover:shadow-md hover:border-oro/30 transition-all duration-300 flex items-center justify-between no-underline"
        >
          <div class="flex items-center gap-4">
            <span class="h-8 w-8 text-chocolate shrink-0" set:html={Camera} />
            <div>
              <h3
                class="font-serif text-lg font-bold text-chocolate group-hover:text-granate transition-colors"
              >
                Perfil de Instagram
              </h3>
              <p class="text-sm text-marron mt-1">
                Publicaciones didácticas y contenido diario.
              </p>
            </div>
          </div>
          <span
            class="text-oro group-hover:translate-x-1 transition-transform font-bold text-lg"
            >&rarr;</span
          >
        </a>

        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white border border-gray-100 p-6 rounded-xl shadow-sm hover:shadow-md hover:border-oro/30 transition-all duration-300 flex items-center justify-between no-underline"
        >
          <div class="flex items-center gap-4">
            <span
              class="h-8 w-8 text-chocolate shrink-0"
              set:html={MessageCircle}
            />
            <div>
              <h3
                class="font-serif text-lg font-bold text-chocolate group-hover:text-granate transition-colors"
              >
                Página de Facebook
              </h3>
              <p class="text-sm text-marron mt-1">
                Comunidad virtual y transmisiones compartidas.
              </p>
            </div>
          </div>
          <span
            class="text-oro group-hover:translate-x-1 transition-transform font-bold text-lg"
            >&rarr;</span
          >
        </a>
      </div>
    </div>
    <div class="text-center mb-12">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-chocolate mb-3">
        Próximos eventos
      </h2>
      <p class="text-sm text-marron font-medium tracking-wide uppercase">
        Estos son los siguientes eventos
      </p>
      <div class="flex flex-col gap-4 items-center mt-8">
        {
          events.map((event) => (
            <div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm w-full max-w-md text-center">
              <p class="text-sm text-oro font-semibold tracking-wide uppercase">{event.date}</p>
              <h3 class="font-serif text-lg font-bold text-chocolate mt-1">{event.title}</h3>
              <p class="text-sm text-marron mt-1">{event.Lugar}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
