---
import Layout from "../layouts/Layout.astro";
import khaledVentana from "../assets/images/khaled_ventana.jpg";
---

<Layout title="Contacto">
  <section class="relative py-28 md:py-36 text-center overflow-hidden flex flex-col justify-center min-h-[60vh]">
    <img
      src={khaledVentana.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-chocolate/85"></div>
    <div class="relative z-10 max-w-[800px] mx-auto px-6">
      <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-4">
        Contacto
      </span>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-white">
        Ponte en contacto
      </h1>
    </div>
  </section>

  <section class="py-20 bg-gris-claro">
    <div class="max-w-lg mx-auto px-6">

      <form id="contact-form" class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 space-y-6">
        <div>
          <label for="nombre" class="block text-sm font-medium text-chocolate mb-1">Nombre</label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            class="block w-full rounded-lg border border-gray-200 px-4 py-3 text-sm text-chocolate placeholder:text-marron/50 focus:outline-none focus:ring-2 focus:ring-oro/40 focus:border-oro transition-colors"
            placeholder="Tu nombre"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-chocolate mb-1">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="block w-full rounded-lg border border-gray-200 px-4 py-3 text-sm text-chocolate placeholder:text-marron/50 focus:outline-none focus:ring-2 focus:ring-oro/40 focus:border-oro transition-colors"
            placeholder="tu@email.com"
          />
        </div>

        <div>
          <label for="mensaje" class="block text-sm font-medium text-chocolate mb-1">Mensaje</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="4"
            required
            class="block w-full rounded-lg border border-gray-200 px-4 py-3 text-sm text-chocolate placeholder:text-marron/50 focus:outline-none focus:ring-2 focus:ring-oro/40 focus:border-oro transition-colors"
            placeholder="Escribe tu mensaje..."
          ></textarea>
        </div>

        <div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-chocolate text-white py-3 px-6 rounded-lg font-medium text-sm hover:bg-chocolate/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-oro/40 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Enviar Mensaje
          </button>
        </div>

        <div id="form-message" class="hidden text-center text-sm"></div>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const messageDiv = document.getElementById("form-message") as HTMLDivElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";
      messageDiv.classList.add("hidden");

      const formData = new FormData(form);

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (response.ok) {
          messageDiv.textContent = "Mensaje enviado correctamente.";
          messageDiv.className = "text-center text-sm text-green-600";
          form.reset();
        } else {
          messageDiv.textContent = data.error || "Error al enviar el mensaje.";
          messageDiv.className = "text-center text-sm text-red-600";
        }
      } catch {
        messageDiv.textContent = "Error de conexión. Intenta de nuevo.";
        messageDiv.className = "text-center text-sm text-red-600";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Enviar Mensaje";
        messageDiv.classList.remove("hidden");
      }
    });
  </script>
</Layout>