---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto">
  <section class="py-24 bg-gris-claro">
    <div class="max-w-lg mx-auto px-6">
      <div class="text-center mb-12">
        <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-4">
          Contacto
        </span>
        <h1 class="font-serif text-3xl md:text-4xl font-bold text-chocolate">
          Ponte en contacto
        </h1>
      </div>

      <form class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 space-y-6">
        <div>
          <label for="nombre" class="block text-sm font-medium text-chocolate mb-1">Nombre</label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            class="block w-full rounded-lg border border-gray-200 px-4 py-3 text-sm text-chocolate placeholder:text-marron/50 focus:outline-none focus:ring-2 focus:ring-oro/40 focus:border-oro transition-colors"
            placeholder="Tu nombre"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-chocolate mb-1">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="block w-full rounded-lg border border-gray-200 px-4 py-3 text-sm text-chocolate placeholder:text-marron/50 focus:outline-none focus:ring-2 focus:ring-oro/40 focus:border-oro transition-colors"
            placeholder="tu@email.com"
          />
        </div>

        <div>
          <label for="mensaje" class="block text-sm font-medium text-chocolate mb-1">Mensaje</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="4"
            required
            class="block w-full rounded-lg border border-gray-200 px-4 py-3 text-sm text-chocolate placeholder:text-marron/50 focus:outline-none focus:ring-2 focus:ring-oro/40 focus:border-oro transition-colors"
            placeholder="Escribe tu mensaje..."
          ></textarea>
        </div>

        <div>
          <button
            type="submit"
            class="w-full bg-chocolate text-white py-3 px-6 rounded-lg font-medium text-sm hover:bg-chocolate/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-oro/40 transition-colors"
          >
            Enviar Mensaje
          </button>
        </div>
      </form>
    </div>
  </section>
</Layout>