---
import Layout from "../layouts/Layout.astro";
import khaledVentana from "../assets/images/khaled_ventana.jpg";
---

<Layout title="Contacto">
  <section class="relative py-28 md:py-36 text-center overflow-hidden flex flex-col justify-center min-h-[60vh]">
    <img
      src={khaledVentana.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-chocolate/85"></div>
    <div class="relative z-10 max-w-[800px] mx-auto px-6">
      <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-4">
        Contacto
      </span>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-white">
        Ponte en contacto
      </h1>
    </div>
  </section>

  <section class="py-24 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      <div class="max-w-lg mx-auto">
        <div class="mb-8">
            <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-3">
              Escríbenos
            </span>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-chocolate">
              Envíanos un mensaje
            </h2>
          </div>

          <form id="contact-form" class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 space-y-5">
            <div>
              <label for="nombre" class="block text-sm font-medium text-chocolate mb-1.5">Nombre</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                class="block w-full rounded-lg border border-gray-200 px-4 py-3 text-sm text-chocolate placeholder:text-marron/50 focus:outline-none focus:ring-2 focus:ring-oro/40 focus:border-oro transition-colors bg-white"
                placeholder="Tu nombre"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-chocolate mb-1.5">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="block w-full rounded-lg border border-gray-200 px-4 py-3 text-sm text-chocolate placeholder:text-marron/50 focus:outline-none focus:ring-2 focus:ring-oro/40 focus:border-oro transition-colors bg-white"
                placeholder="tu@email.com"
              />
            </div>

            <div>
              <label for="mensaje" class="block text-sm font-medium text-chocolate mb-1.5">Mensaje</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                class="block w-full rounded-lg border border-gray-200 px-4 py-3 text-sm text-chocolate placeholder:text-marron/50 focus:outline-none focus:ring-2 focus:ring-oro/40 focus:border-oro transition-colors bg-white resize-y"
                placeholder="Escribe tu mensaje..."
              ></textarea>
            </div>

            <div>
              <button
                type="submit"
                id="submit-btn"
                class="w-full bg-chocolate text-white py-3 px-6 rounded-lg font-medium text-sm hover:bg-chocolate/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-oro/40 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Enviar Mensaje
              </button>
            </div>

            <div id="form-message" class="hidden text-center text-sm"></div>
          </form>
        </div>

        <div class="lg:col-span-2 space-y-6">
          <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
            <h3 class="font-serif text-lg font-bold text-chocolate mb-5">
              Información de contacto
            </h3>

            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="w-9 h-9 bg-oro/10 rounded-lg flex items-center justify-center shrink-0">
                  <span set:html={Mail} class="w-4 h-4 text-oro" />
                </div>
                <div>
                  <p class="text-xs text-marron/60 font-medium tracking-wide uppercase">Email</p>
                  <a href="mailto:kane.wwe@gmail.com" class="text-sm text-chocolate font-medium hover:text-oro transition-colors no-underline">
                    kane.wwe@gmail.com
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-9 h-9 bg-oro/10 rounded-lg flex items-center justify-center shrink-0">
                  <span set:html={MessageCircle} class="w-4 h-4 text-oro" />
                </div>
                <div>
                  <p class="text-xs text-marron/60 font-medium tracking-wide uppercase">WhatsApp</p>
                  <a href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="text-sm text-chocolate font-medium hover:text-oro transition-colors no-underline">
                    Enviar mensaje
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-9 h-9 bg-oro/10 rounded-lg flex items-center justify-center shrink-0">
                  <span set:html={Send} class="w-4 h-4 text-oro" />
                </div>
                <div>
                  <p class="text-xs text-marron/60 font-medium tracking-wide uppercase">Redes</p>
                  <div class="flex gap-2 mt-1">
                    <a href="https://www.youtube.com/@khaledhuerta" target="_blank" rel="noopener noreferrer" class="text-sm text-chocolate/70 hover:text-red-600 transition-colors no-underline">YouTube</a>
                    <span class="text-marron/30">·</span>
                    <a href="https://www.instagram.com/khaled.huerta/" target="_blank" rel="noopener noreferrer" class="text-sm text-chocolate/70 hover:text-pink-600 transition-colors no-underline">Instagram</a>
                    <span class="text-marron/30">·</span>
                    <a href="https://www.facebook.com/khaled.huerta/" target="_blank" rel="noopener noreferrer" class="text-sm text-chocolate/70 hover:text-blue-600 transition-colors no-underline">Facebook</a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-oro/5 border border-oro/20 rounded-xl p-8 text-center">
            <p class="font-serif text-base md:text-lg text-chocolate italic leading-relaxed">
              "Quien facilita una dificultad de este mundo, Allah le facilitará una dificultad en el Día de la Resurrección."
            </p>
            <p class="text-xs text-marron/60 mt-3">Muslim</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const messageDiv = document.getElementById("form-message") as HTMLDivElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando...";
    messageDiv.classList.add("hidden");

    const formData = new FormData(form);

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      if (response.ok) {
        messageDiv.textContent = "Mensaje enviado correctamente.";
        messageDiv.className = "text-center text-sm text-green-600";
        form.reset();
      } else {
        messageDiv.textContent = data.error || "Error al enviar el mensaje.";
        messageDiv.className = "text-center text-sm text-red-600";
      }
    } catch {
      messageDiv.textContent = "Error de conexión. Intenta de nuevo.";
      messageDiv.className = "text-center text-sm text-red-600";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar Mensaje";
      messageDiv.classList.remove("hidden");
    }
  });
</script>
