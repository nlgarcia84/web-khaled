---
import khaledEscritorio from "../assets/images/khaled_escritorio.JPG";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Biografía">
  <section class="relative py-20 md:py-28 text-center overflow-hidden flex flex-col justify-center">
    <img
      src={khaledEscritorio.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-chocolate/85"></div>

    <div class="relative z-10 max-w-[800px] mx-auto px-6 hero-content">
      <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-4">
        Sobre el Autor
      </span>
      <h1 class="font-serif text-4xl md:text-6xl font-bold tracking-tight text-white mb-8 leading-tight">
        Sheij Khaled Huerta
      </h1>
      <p class="font-sans text-lg md:text-xl text-crema/80 font-light leading-relaxed">
        Un camino riguroso dedicado a la preservación, traducción y difusión
        de las ciencias tradicionales del Islam en lengua española.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-[1140px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
        <div class="lg:col-span-4 lg:sticky lg:top-28 h-fit space-y-4 trayectoria-sidebar">
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-chocolate">
            Metodología y Enfoque
          </h2>
          <div class="w-12 h-[2px] bg-oro"></div>
          <p class="text-marron text-sm leading-relaxed max-w-sm">
            Formación tradicional estructurada bajo la estricta supervisión de
            eruditos, priorizando la cadena de transmisión autorizada (Ijazah) y
            la rectitud en los modales.
          </p>
        </div>

        <div
          class="lg:col-span-8 space-y-16 relative before:absolute before:left-4 before:top-2 before:bottom-2 before:w-[1px] before:bg-gray-100"
        >
          <div class="relative pl-12 group trayectoria-item">
            <div class="absolute left-[13px] top-2 w-2 h-2 rounded-full bg-oro/40 group-hover:bg-oro transition-colors duration-300">
            </div>

            <h3 class="font-serif text-xl font-bold text-chocolate mb-3 group-hover:text-granate transition-colors">
              Transmisión en Lengua Española
            </h3>
            <p class="text-chocolate/80 text-base leading-relaxed max-w-2xl">
              Consolidación de una metodología adaptada al entorno
              hispanohablante. Traduciendo textos clásicos de referencia en
              jurisprudencia (Fiqh), credo ('Aqidah) y ciencias del Hadiz sin
              alterar el rigor académico original.
            </p>
          </div>

          <div class="relative pl-12 group trayectoria-item">
            <div class="absolute left-[13px] top-2 w-2 h-2 rounded-full bg-oro/40 group-hover:bg-oro transition-colors duration-300">
            </div>

            <h3 class="font-serif text-xl font-bold text-chocolate mb-3 group-hover:text-granate transition-colors">
              Formación y Ciencias Tradicionales
            </h3>
            <p class="text-chocolate/80 text-base leading-relaxed max-w-2xl">
              Estudio sistemático de los dictámenes legales contemporáneos y
              memorización de los textos que estructuran el entramado legal de
              la jurisprudencia islámica tradicional.
            </p>
          </div>

          <div class="relative pl-12 group trayectoria-item">
            <div class="absolute left-[13px] top-2 w-2 h-2 rounded-full bg-oro/40 group-hover:bg-oro transition-colors duration-300">
            </div>

            <h3 class="font-serif text-xl font-bold text-chocolate mb-3 group-hover:text-granate transition-colors">
              Línea de Maestros y Autorización
            </h3>
            <p class="text-chocolate/80 text-base leading-relaxed max-w-2xl">
              Instrucción directa recibida de destacados sabios y jurisconsultos
              de la comunidad islámica contemporánea, manteniendo el compromiso
              con los valores y modales de los rectos predecesores.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import gsap from "gsap";

  function revealOnScroll(selector, { from = "bottom", stagger = 0.08, distance = 40 } = {}) {
    const els = document.querySelectorAll(selector);
    if (!els.length) return;
    gsap.set(els, { willChange: "transform, opacity" });
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (!visible.length) return;
        const targets = visible.map((e) => e.target);
        const base = { duration: 0.9, ease: "power3.out", overwrite: "auto", force3D: true };
        if (from === "bottom") {
          gsap.fromTo(targets, { y: distance, opacity: 0, filter: "blur(2px)" }, { y: 0, opacity: 1, filter: "blur(0px)", stagger, ...base });
        } else if (from === "side") {
          targets.forEach((t, i) => {
            const dir = i % 2 === 0 ? -1 : 1;
            gsap.fromTo(t, { x: dir * 40, opacity: 0, filter: "blur(2px)" }, { x: 0, opacity: 1, filter: "blur(0px)", delay: i * stagger, ...base, onComplete: () => { t.style.opacity = ""; t.style.filter = ""; } });
          });
        }
        targets.forEach((t) => observer.unobserve(t));
      },
      { threshold: 0.2 },
    );
    els.forEach((el) => observer.observe(el));
  }

  gsap.from(".hero-content > *", {
    y: 60,
    opacity: 0,
    filter: "blur(2px)",
    duration: 0.9,
    stagger: 0.12,
    ease: "power3.out",
    force3D: true,
  });

  revealOnScroll(".trayectoria-sidebar", { from: "bottom", stagger: 0.1, distance: 40 });
  revealOnScroll(".trayectoria-item", { from: "side", stagger: 0.1 });
</script>