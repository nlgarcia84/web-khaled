---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import { getEpisodes } from "../lib/ivoox";
import khaledMicro from "../assets/images/khaled_micro.jpeg";

const feed = await getEpisodes();
const episodes = feed.episodes;

function formatDate(iso: string): string {
  const d = new Date(iso);
  return isNaN(d.getTime())
    ? ""
    : d.toLocaleDateString("es", {
        year: "numeric",
        month: "long",
        day: "numeric",
      });
}
---

<Layout
  title="Audios"
  description="Audios y lecciones de Sheij Khaled Huerta: audiolibros, tafsír del Corán y conferencias en español desde iVoox."
>
  <HeroSection
    image={khaledMicro}
    label="Audios"
    title="Lecciones en audio"
    description="Audiolibros, explicaciones del Corán y conferencias en español. Escúchalos aquí o en iVoox."
    overlay="gradient-dark"
  />

  <section class="py-20 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      <div
        class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-12"
      >
        <div>
          <span
            class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-3"
          >
            Podcast
          </span>
          <h2 class="font-serif text-3xl md:text-4xl font-bold text-chocolate">
            Episodios
          </h2>
          <p class="text-sm text-marron mt-2">
            {episodes.length} audios publicados
          </p>
        </div>
        <a
          href="https://www.ivoox.com/podcast-khaled-huerta_sq_f11766594_1.html"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-oro text-chocolate font-bold px-5 py-2.5 rounded-lg hover:bg-oro/90 transition-colors no-underline text-sm"
        >
          Ver en iVoox
          <span class="text-lg">&rarr;</span>
        </a>
      </div>

      <div class="space-y-4">
        {
          episodes.map((ep) => (
            <article class="audio-card group bg-white border border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-oro/30 transition-all duration-300">
              <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                <div class="flex-1 min-w-0">
                  <h3 class="font-serif text-lg font-bold text-chocolate leading-snug group-hover:text-granate transition-colors">
                    {ep.title}
                  </h3>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-xs text-marron font-medium">
                    {ep.duration && (
                      <span class="inline-flex items-center gap-1">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          class="w-3.5 h-3.5"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="12" cy="12" r="10" />
                          <polyline points="12 6 12 12 16 14" />
                        </svg>
                        {ep.duration}
                      </span>
                    )}
                    {formatDate(ep.pubDate) && (
                      <span class="inline-flex items-center gap-1">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          class="w-3.5 h-3.5"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <rect
                            x="3"
                            y="4"
                            width="18"
                            height="18"
                            rx="2"
                            ry="2"
                          />
                          <line x1="16" y1="2" x2="16" y2="6" />
                          <line x1="8" y1="2" x2="8" y2="6" />
                          <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        {formatDate(ep.pubDate)}
                      </span>
                    )}
                    <a
                      href={ep.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-oro underline underline-offset-2 font-semibold hover:text-granate transition-colors"
                    >
                      iVoox
                    </a>
                  </div>
                </div>
                <span class="inline-flex items-center gap-2 shrink-0">
                  <a
                    href={ep.audioUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-oro text-chocolate font-bold px-4 py-2 rounded-lg hover:bg-oro/90 transition-colors no-underline text-sm"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="w-4 h-4"
                    >
                      <polygon points="5 3 19 12 5 21 5 3" />
                    </svg>
                    Escuchar
                  </a>
                </span>
              </div>

              <details class="mt-4">
                <summary class="cursor-pointer text-sm font-medium text-marron hover:text-oro transition-colors select-none">
                  Descripción
                </summary>
                <p class="text-sm text-marron/80 leading-relaxed mt-3 line-clamp-4">
                  {ep.description}
                </p>
              </details>
            </article>
          ))
        }
      </div>

      <p class="text-center text-sm text-marron mt-12">
        Todos los audios están publicados en{" "}
        <a
          href="https://www.ivoox.com/podcast-khaled-huerta_sq_f11766594_1.html"
          target="_blank"
          rel="noopener noreferrer"
          class="text-oro underline underline-offset-2 font-semibold hover:text-granate transition-colors"
        >
          iVoox
        </a>
      </p>
    </div>
  </section>
</Layout>

<script>
  import gsap from "gsap";

  gsap.from(".audio-card", {
    y: 40,
    opacity: 0,
    duration: 0.7,
    stagger: 0.06,
    ease: "power2.out",
    force3D: true,
  });
</script>
