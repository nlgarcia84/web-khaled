---
import { Image } from "astro:assets";
import { PortableText } from "astro-portabletext";
import type { Props as PortableTextProps } from "astro-portabletext/types";
import { createImageUrlBuilder } from "@sanity/image-url";
import { client, getPost, getPosts } from "../../lib/sanity";
import Layout from "../../layouts/Layout.astro";

// Definición de interfaces para tipado estricto en producción
interface SanityImage {
  _type: "image";
  asset: {
    _ref: string;
    _type: "reference";
  };
  alt?: string;
}

interface Post {
  title: string;
  publishedAt: string;
  image?: SanityImage;
  author?: string;
  body: any[];
}

const builder = createImageUrlBuilder(client);

// Componentes personalizados para el árbol de PortableText de Astro
const portableTextComponents = {
  type: {
    // Renderizado seguro y optimizado de imágenes dentro del cuerpo del texto
    image: ({ node }: PortableTextProps<SanityImage>) => {
      const imageUrl = builder
        .image(node)
        .width(800)
        .format("webp")
        .quality(80)
        .url();
      const alt = node.alt || "Imagen del artículo";
      return `<figure class="my-8"><img src="${imageUrl}" alt="${alt}" width="800" height="450" class="rounded-xl w-full object-cover" loading="lazy" decoding="async" /></figure>`;
    },
  },
};

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post: { slug: { current: string } }) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params as { slug: string };
const post = (await getPost(slug)) as Post;

// Validación defensiva en Build-Time
if (!post) {
  return Astro.redirect("/404");
}

const heroImageUrl = post.image
  ? builder.image(post.image).width(1200).format("webp").quality(80).url()
  : null;
---

<Layout title={post.title}>
  <article class="py-24">
    <div class="max-w-200 mx-auto px-6">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-marron/60 hover:text-oro transition-colors no-underline mb-6"
      >
        <span class="w-4 h-4">&larr;</span>
        Volver al blog
      </a>

      <time class="text-sm text-oro font-medium" datetime={post.publishedAt}>
        {
          new Date(post.publishedAt).toLocaleDateString("es", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>

      {
        heroImageUrl && (
          <figure class="my-8">
            <Image
              src={heroImageUrl}
              alt={`Imagen de portada para ${post.title}`}
              width={1200}
              height={500}
              class="w-full h-64 md:h-96 object-cover rounded-xl"
              fetchpriority="high"
              loading="eager"
            />
          </figure>
        )
      }

      <h1
        class="font-serif text-4xl md:text-5xl font-bold text-chocolate mt-2 mb-4"
      >
        {post.title}
      </h1>

      {post.author && <p class="text-marron text-sm mb-8">Por {post.author}</p>}

      {
        /* Renderizado estructural nativo sin inyección de strings HTML crudos */
      }
      <div class="prose prose-lg max-w-none text-marron leading-relaxed">
        {
          post.body && (
            <PortableText
              value={post.body}
              components={portableTextComponents}
            />
          )
        }
      </div>
    </div>
  </article>
</Layout>
