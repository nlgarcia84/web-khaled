---
import { createImageUrlBuilder } from "@sanity/image-url";
import ArrowRight from "lucide-static/dist/esm/icons/arrow-right.mjs";
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/HeroSection.astro";
import PostCard from "../../components/PostCard.astro";
import { client, getPosts } from "../../lib/sanity";
import khaledLectura from "../../assets/images/khaled_lectura.jpg";

const builder = createImageUrlBuilder(client);
const posts = await getPosts();
const featured = posts[0];
const rest = posts.slice(1);
---

<Layout
  title="Blog"
  description="Artículos y reflexiones de Sheij Khaled Huerta sobre la fe, la vida y el camino hacia Allah."
>
  <HeroSection
    image={khaledLectura}
    label="Blog"
    title="Artículos y reflexiones"
    titleAccent="reflexiones"
    description="Textos, notas y reflexiones sobre la fe, la vida y el camino hacia Al-lah."
    titleSize="md"
    maxWidth="1140px"
    imagePosition="center 30%"
  />

  <section class="py-20 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      {
        featured && (
          <a
            href={`/blog/${featured.slug.current}`}
            class="post-card group relative mb-12 grid grid-cols-1 overflow-hidden rounded-3xl border border-oro/20 bg-white/70 shadow-lg shadow-black/5 backdrop-blur-xl no-underline transition-all duration-300 hover:-translate-y-1 hover:border-oro/50 hover:shadow-xl hover:shadow-oro/10 md:grid-cols-5"
          >
            <div class="relative overflow-hidden bg-chocolate/5 md:col-span-2">
              {featured.image ? (
                <img
                  src={builder
                    .image(featured.image)
                    .width(600)
                    .height(400)
                    .format("webp")
                    .quality(80)
                    .url()}
                  alt={featured.title}
                  class="h-64 w-full object-cover transition-transform duration-700 group-hover:scale-105 md:h-full"
                  fetchpriority="high"
                />
              ) : (
                <div class="flex h-64 w-full items-center justify-center bg-gradient-to-br from-oro/15 via-crema/20 to-chocolate/10 md:h-full">
                  <span class="font-serif text-6xl text-oro/40">📖</span>
                </div>
              )}
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-chocolate/50 via-transparent to-transparent opacity-60" />
              <span class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full border border-oro/40 bg-chocolate/60 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-crema backdrop-blur-sm">
                <span class="h-1.5 w-1.5 rounded-full bg-oro" />
                Destacado
              </span>
            </div>
            <div class="flex flex-col justify-center p-8 md:col-span-3 md:p-10">
              <div class="mb-4 flex flex-wrap items-center gap-2">
                {featured.categories?.slice(0, 2).map((cat: any) => (
                  <span class="inline-flex items-center rounded-full border border-oro/30 bg-oro/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.15em] text-marron">
                    {cat.title}
                  </span>
                ))}
                <span class="ml-auto text-xs text-marron/70">
                  {new Date(featured.publishedAt).toLocaleDateString("es", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </span>
              </div>
              <h2 class="font-serif text-2xl font-bold leading-tight text-chocolate transition-colors group-hover:text-granate md:text-3xl">
                {featured.title}
              </h2>
              {featured.excerpt && (
                <p class="mt-3 text-marron/80 leading-relaxed line-clamp-3">
                  {featured.excerpt}
                </p>
              )}
              <div class="mt-7 flex items-center justify-between gap-4 border-t border-oro/10 pt-5">
                <div class="flex min-w-0 items-center gap-3">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-oro/15 text-xs font-bold text-marron">
                    {featured.author?.charAt(0) || "K"}
                  </div>
                  <span class="truncate text-sm font-medium text-chocolate">
                    {featured.author || "Sheij Khaled Huerta"}
                  </span>
                </div>
                <span class="inline-flex shrink-0 items-center gap-2 text-xs font-semibold text-marron transition-colors group-hover:text-granate">
                  Leer artículo
                  <span class="flex h-8 w-8 items-center justify-center rounded-full border border-oro/30 bg-white/50 transition-all duration-300 group-hover:translate-x-0.5 group-hover:bg-oro group-hover:text-chocolate">
                    <span class="h-4 w-4" set:html={ArrowRight} />
                  </span>
                </span>
              </div>
            </div>
          </a>
        )
      }

      {
        posts.length === 0 && (
          <div class="post-card text-center py-20">
            <span class="font-serif text-5xl text-oro/40">📖</span>
            <p class="mt-4 text-lg text-chocolate font-medium">
              Todavía no hay artículos publicados
            </p>
            <p class="mt-1 text-sm text-marron">
              Vuelve pronto para leer nuevas reflexiones.
            </p>
          </div>
        )
      }

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          rest.map((post: any) => (
            <PostCard
              post={post}
              variant="grid"
              imageUrl={
                post.image
                  ? builder
                      .image(post.image)
                      .width(600)
                      .height(340)
                      .format("webp")
                      .quality(80)
                      .url()
                  : undefined
              }
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  import { revealOnScroll } from "../../lib/scroll-reveal";

  revealOnScroll(".post-card", { stagger: 0.08, distance: 24 });
</script>
