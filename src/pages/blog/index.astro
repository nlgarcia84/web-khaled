---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/sanity";
import khaledJardin from "../../assets/images/khaled_jardin.JPG";
const posts = await getPosts();
---

<Layout title="Blog">
  <section class="relative py-28 md:py-36 text-center overflow-hidden flex flex-col justify-center min-h-[50vh]">
    <img
      src={khaledJardin.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-[center_30%]"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-chocolate/85"></div>
    <div class="relative z-10 max-w-[1140px] mx-auto px-6">
      <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-4">
        Blog
      </span>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-white">
        Artículos y reflexiones
      </h1>
    </div>
  </section>

  <section class="py-20 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-200 mx-auto">
        {
          posts.map((post: any) => (
            <a
              href={`/blog/${post.slug.current}`}
              class="group bg-white border border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-oro/30 transition-all duration-300 no-underline block"
            >
              <article>
                <h2 class="font-serif text-lg font-bold text-chocolate group-hover:text-granate transition-colors">
                  {post.title}
                </h2>
                {post.excerpt && <p class="text-marron text-sm mt-2 leading-relaxed">{post.excerpt}</p>}
                <time class="text-xs text-oro mt-3 block font-medium">
                  {new Date(post.publishedAt).toLocaleDateString("es", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </article>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
