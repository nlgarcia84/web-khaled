---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import { getCampaign } from "../lib/sanity";
import khalesMusala from "../assets/images/khales_musala.jpeg";

const campaign = await getCampaign("alfombra");
const goal = campaign?.goal ?? 1000;
const raised = campaign?.raised ?? 0;
const percentage = goal > 0 ? Math.round((raised / goal) * 100) : 0;
---

<Layout title="Donar">
  <HeroSection
    image={khalesMusala}
    quote='"La caridad no disminuye la riqueza" (Muslim)'
    title="Apoya la Musala"
    description="Tu donación ayuda a mantener y expandir los servicios de la musala para toda la comunidad. Cada contribución, por pequeña que sea, marca la diferencia."
    titleSize="lg"
    imagePosition="center 80%"
  />

  <section class="py-20 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      <div class="section-header">
        <h2
          class="font-serif text-2xl md:text-3xl font-bold text-chocolate text-center mb-8"
        >
          Campañas activas
        </h2>
      </div>

      <div
        class="bg-gradient-to-br from-green-50 to-green-100/50 border border-green-300 p-6 rounded-xl shadow-sm mb-6 max-w-200 mx-auto"
      >
        <div class="flex items-center gap-4">
          <span class="text-2xl shrink-0">🕌</span>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h3 class="font-serif text-lg font-bold text-chocolate">
                Alfombra para la Musala
              </h3>
              <span
                class="text-xs font-bold tracking-wider uppercase bg-green-600 text-white px-2.5 py-0.5 rounded-full"
              >
                Conseguido
              </span>
            </div>
            <p class="text-sm text-green-700 font-medium mt-1">
              Meta: {goal.toLocaleString()} € — ¡Superada! ({
                raised.toLocaleString()
              } € recaudados)
            </p>
          </div>
        </div>
      </div>

      <div class="section-header">
        <h2
          class="font-serif text-xl md:text-2xl font-bold text-chocolate text-center mb-6 mt-14"
        >
          Donaciones generales
        </h2>
      </div>

      <div
        class="bg-gradient-to-br from-oro/10 to-chocolate/5 border border-oro/30 p-6 rounded-xl shadow-sm max-w-200 mx-auto mb-6"
        id="general-donation-card"
      >
        <div class="flex items-center gap-4">
          <span class="text-2xl shrink-0">🤲</span>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h3 class="font-serif text-lg font-bold text-chocolate">
                Donación sin campaña específica
              </h3>
            </div>
            <p class="text-sm text-marron mt-1">
              Puedes donar directamente con tarjeta, PayPal o transferencia
              bancaria. Tu contribución se destinará a los gastos generales de
              la musala.
            </p>
          </div>
        </div>

        <div
          id="general-donation-form"
          class="mt-6 pt-6 border-t border-oro/20"
        >
          <p
            class="font-serif text-base font-bold text-chocolate mb-4 text-center"
          >
            Elige tu contribución
          </p>

          <div class="grid grid-cols-3 gap-3 mb-6">
            <button
              class="gen-amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
              data-amount="10">10 €</button
            >
            <button
              class="gen-amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
              data-amount="20">20 €</button
            >
            <button
              class="gen-amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
              data-amount="50">50 €</button
            >
            <button
              class="gen-amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
              data-amount="100">100 €</button
            >
            <button
              class="gen-amount-btn border-2 border-oro bg-oro/5 rounded-lg py-3 px-4 text-center transition-colors cursor-pointer font-bold text-chocolate"
              data-amount="200">200 €</button
            >
            <button
              class="gen-amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
              data-amount="500">500 €</button
            >
          </div>

          <div class="mb-6">
            <label class="block text-sm text-marron mb-2">Otra cantidad</label>
            <div class="relative">
              <span
                class="absolute left-4 top-1/2 -translate-y-1/2 text-chocolate font-medium"
                >€</span
              >
              <input
                type="number"
                id="gen-custom-amount"
                min="1"
                step="1"
                placeholder="0"
                class="w-full border border-gray-200 rounded-lg py-3 pl-10 pr-4 text-chocolate font-medium focus:outline-none focus:border-oro focus:ring-1 focus:ring-oro"
              />
            </div>
          </div>

          <button
            id="gen-stripe-btn"
            class="w-full bg-chocolate text-white text-center py-3 px-6 rounded-lg font-medium hover:bg-chocolate/90 transition-colors cursor-pointer border-none text-base"
          >
            Donar con tarjeta
          </button>

          <div id="gen-paypal-btn" class="w-full"></div>

          <details class="group">
            <summary
              class="list-none w-full text-center py-3 px-6 rounded-lg font-medium border border-oro text-oro hover:bg-oro/5 transition-colors cursor-pointer"
            >
              Transferencia bancaria
            </summary>
            <div class="mt-4 p-4 bg-gris-claro rounded-lg space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-marron">Banco</span>
                <span class="text-chocolate font-medium">BBVA Bancomer</span>
              </div>
              <div class="flex justify-between">
                <span class="text-marron">CLABE</span>
                <span class="text-chocolate font-mono font-medium"
                  >00743521001566551081</span
                >
              </div>
              <div class="flex justify-between">
                <span class="text-marron">Titular</span>
                <span class="text-chocolate font-medium"
                  >Sheij Khaled Huerta</span
                >
              </div>
              <div class="flex justify-between">
                <span class="text-marron">Referencia</span>
                <span class="text-chocolate font-medium">DONACIÓN</span>
              </div>
            </div>
          </details>
        </div>
      </div>

      <div class="section-header">
        <h2
          class="font-serif text-xl md:text-2xl font-bold text-chocolate text-center mb-6"
        >
          Métodos de pago
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-200 mx-auto">
        <div
          class="bg-white border-l-4 border-l-gray-300 rounded-lg shadow-sm p-5"
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 shrink-0 flex items-center justify-center">
              <svg
                viewBox="0 0 24 24"
                class="h-6"
                fill="none"
                stroke="#888"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </div>
            <div>
              <h3
                class="font-sans text-sm font-bold text-chocolate uppercase tracking-wide"
              >
                Tarjeta
              </h3>
              <p class="text-xs text-marron mt-0.5">
                Visa, Mastercard, AMEX — Pago seguro
              </p>
            </div>
          </div>
        </div>

        <div
