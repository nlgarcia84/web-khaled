              <h3
                class="font-sans text-sm font-bold text-chocolate uppercase tracking-wide"
              >
                Bitcoin
              </h3>
              <p class="text-xs text-marron mt-0.5">
                Próximamente — Dirección de Bitso
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <div class="bg-oro/5 border border-oro/20 rounded-xl p-8 md:p-12">
        <p
          class="font-arabic text-xl md:text-2xl leading-loose text-chocolate mb-6"
          dir="rtl"
        >
          إذا ماتَ الإنسانُ انقَطَعَ عنه عَمَلُه إلَّا مِن ثَلاثةٍ: إلَّا مِن
          صَدَقةٍ جاريةٍ، أو عِلمٍ يُنتَفَعُ به، أو ولَدٍ صالِحٍ يَدعو له.
        </p>
        <p
          class="font-serif text-lg md:text-xl text-chocolate italic leading-relaxed mb-6"
        >
          "Cuando una persona muere, todas sus obras llegan a su fin, excepto
          tres: una caridad continua, un conocimiento beneficioso, o un hijo
          justo que ruega por él."
        </p>
        <p class="text-xs text-marron font-medium">Sahih Muslim 1631</p>
        <div class="w-12 h-[1px] bg-oro/40 mx-auto my-6"></div>
        <p class="text-sm text-marron leading-relaxed">
          Tu donación es una inversión para tu ākhirah. Cada vez que alguien
          rece en esta musala, estudie en ella o encuentre guía, la recompensa
          llegará a ti, por voluntad de Allāh.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const amountBtns = document.querySelectorAll(".gen-amount-btn");
  const customInput = document.getElementById(
    "gen-custom-amount",
  ) as HTMLInputElement;
  let selectedAmount = 200;

  amountBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      amountBtns.forEach((b) => {
        b.classList.remove("border-2", "border-oro", "bg-oro/5", "font-bold");
        b.classList.add("border", "border-gray-200", "font-medium");
      });
      btn.classList.remove("border", "border-gray-200", "font-medium");
      btn.classList.add("border-2", "border-oro", "bg-oro/5", "font-bold");
      selectedAmount = parseInt(btn.getAttribute("data-amount") || "0");
      customInput.value = "";
    });
  });

  customInput?.addEventListener("input", () => {
    if (customInput.value) {
      amountBtns.forEach((b) => {
        b.classList.remove("border-2", "border-oro", "bg-oro/5", "font-bold");
        b.classList.add("border", "border-gray-200", "font-medium");
      });
      selectedAmount = parseInt(customInput.value);
    }
  });

  const stripeBtn = document.getElementById(
    "gen-stripe-btn",
  ) as HTMLButtonElement | null;
  stripeBtn?.addEventListener("click", async () => {
    const amount = selectedAmount || parseInt(customInput.value);
    if (!amount || amount < 1) {
      alert("Selecciona una cantidad");
      return;
    }
    stripeBtn.disabled = true;
    stripeBtn.textContent = "Procesando...";
    try {
      const res = await fetch("/api/create-checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ amount }),
      });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert("Error al procesar el pago. Intenta de nuevo.");
      }
    } catch {
      alert("Error de conexión. Intenta de nuevo.");
    } finally {
      stripeBtn.disabled = false;
      stripeBtn.textContent = "Donar con tarjeta";
    }
  });

  const paypalScript = document.createElement("script");
  const clientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
  if (!clientId || clientId === "TU_PAYPAL_CLIENT_ID") {
    const fallback = document.getElementById("gen-paypal-btn");
    if (fallback) {
      fallback.innerHTML = `<a href="https://www.paypal.com/paypalme/huertakhaled" target="_blank" rel="noopener noreferrer" class="block w-full text-center py-3 px-6 rounded-lg font-medium border border-gray-300 text-chocolate hover:border-oro hover:text-oro transition-colors no-underline">Donar con PayPal</a>`;
    }
  } else {
    paypalScript.src = `https://www.paypal.com/sdk/js?client-id=${clientId}&currency=EUR`;
    paypalScript.onload = () => {
      (window as any).paypal
        ?.Buttons?.({
          style: {
            layout: "horizontal",
            shape: "rect",
            label: "paypal",
            tagline: false,
          },
          createOrder() {
            const amount = selectedAmount || parseInt(customInput.value);
            if (!amount || amount < 1) {
              alert("Selecciona una cantidad");
              throw new Error("Missing amount");
            }
            return fetch("/api/create-paypal-order", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ amount }),
            })
              .then((r) => r.json())
              .then((d) => d.id);
          },
          onApprove(data: any) {
            return fetch("/api/capture-paypal-order", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ orderID: data.orderID }),
            }).then(() => {
              window.location.href = "/donar?donacion=exito";
            });
          },
        })
        ?.render("#gen-paypal-btn");
    };
    document.head.appendChild(paypalScript);
  }
</script>
