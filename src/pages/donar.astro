---
import Layout from "../layouts/Layout.astro";
import { getCampaign } from "../lib/sanity";
import khalesMusala from "../assets/images/khales_musala.jpeg";

const campaign = await getCampaign("alfombra");
const goal = campaign?.goal ?? 1000;
const raised = campaign?.raised ?? 0;
const percentage = goal > 0 ? Math.round((raised / goal) * 100) : 0;
---

<Layout title="Donar">
  <section class="relative py-20 md:py-28 text-center overflow-hidden flex flex-col justify-center">
    <img
      src={khalesMusala.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-[center_80%]"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-chocolate/85"></div>
    <div class="relative z-10 max-w-[800px] mx-auto px-6">
      <p
        class="font-serif text-oro text-lg md:text-xl italic font-semibold mb-6"
      >
        "La caridad no disminuye la riqueza" (Muslim)
      </p>
      <h1
        class="font-serif text-white text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-4"
      >
        Apoya la Musala
      </h1>
      <p class="font-sans text-lg md:text-xl text-crema/80 font-light leading-relaxed max-w-2xl mx-auto">
        Tu donación ayuda a mantener y expandir los servicios de la musala
        para toda la comunidad. Cada contribución, por pequeña que sea, marca
        la diferencia.
      </p>
    </div>
  </section>

  <section class="py-20 bg-gris-claro">
    <div class="max-w-[1140px] mx-auto px-6">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-chocolate text-center mb-8">
        Campañas activas
      </h2>

      <a
        href="/alfombra"
        class="group bg-gradient-to-br from-granate/5 to-granate/10 border border-granate/30 p-6 rounded-xl shadow-sm hover:shadow-md hover:border-granate transition-all duration-300 flex items-center justify-between no-underline mb-6 max-w-200 mx-auto"
      >
        <div class="flex items-center gap-4">
          <span class="text-2xl shrink-0">🕌</span>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h3 class="font-serif text-lg font-bold text-granate group-hover:text-chocolate transition-colors">
                Alfombra para la Musala
              </h3>
              <span class="text-xs font-bold tracking-wider uppercase bg-granate text-white px-2.5 py-0.5 rounded-full animate-pulse">
                Urgente
              </span>
            </div>
            <p class="text-sm text-marron mt-1">
              Meta: {goal.toLocaleString()} € — Cada donación acerca la alfombra
            </p>
            <div class="w-full bg-gray-200 rounded-full h-2 mt-2 max-w-60 overflow-hidden">
              <div class="bg-oro h-full rounded-full" style="width: {percentage}%"></div>
            </div>
          </div>
        </div>
        <span class="text-oro group-hover:translate-x-1 transition-transform font-bold text-lg">&rarr;</span>
      </a>

      <h2 class="font-serif text-xl md:text-2xl font-bold text-chocolate text-center mb-6 mt-14">
        Donaciones generales
      </h2>

      <a
        href="/alfombra"
        class="group bg-gradient-to-br from-oro/10 to-chocolate/5 border border-oro/30 p-6 rounded-xl shadow-sm hover:shadow-md hover:border-oro transition-all duration-300 max-w-200 mx-auto mb-14 flex items-center justify-between no-underline"
      >
        <div class="flex items-center gap-4">
          <span class="text-2xl shrink-0">🤲</span>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h3 class="font-serif text-lg font-bold text-chocolate group-hover:text-granate transition-colors">
                Donación sin campaña específica
              </h3>
            </div>
            <p class="text-sm text-marron mt-1">
              Puedes donar directamente con tarjeta, PayPal o transferencia bancaria.
              Tu contribución se destinará a los gastos generales de la musala.
            </p>
          </div>
        </div>
        <span class="text-oro group-hover:translate-x-1 transition-transform font-bold text-lg">&rarr;</span>
      </a>

      <h2 class="font-serif text-xl md:text-2xl font-bold text-chocolate text-center mb-6">
        Métodos de pago
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-200 mx-auto">
        <div
          class="bg-white border-l-4 border-l-oro rounded-lg shadow-sm p-5"
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-oro/10 rounded-lg flex items-center justify-center text-lg shrink-0">
              💳
            </div>
            <div>
              <h3 class="font-sans text-sm font-bold text-chocolate uppercase tracking-wide">
                Tarjeta
              </h3>
              <p class="text-xs text-marron mt-0.5">
                Visa, Mastercard, AMEX — Pago seguro
              </p>
            </div>
          </div>
        </div>

        <div
          class="bg-white border-l-4 border-l-blue-600 rounded-lg shadow-sm p-5"
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 shrink-0 flex items-center justify-center">
