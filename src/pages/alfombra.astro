---
import Layout from "../layouts/Layout.astro";
import { getCampaign } from "../lib/sanity";

const campaign = await getCampaign("alfombra");
const goal = campaign?.goal ?? 1000;
const raised = campaign?.raised ?? 0;
---

<Layout title="Alfombra para la Musala">
  <section
    class="relative py-20 md:py-28 text-center overflow-hidden flex flex-col justify-center min-h-[calc(100svh-5rem)] md:min-h-[calc(100vh-5rem)]"
  >
    <div class="absolute inset-0 bg-chocolate/85"></div>
    <div class="relative z-10 max-w-[800px] mx-auto px-6">
      <h1
        class="font-serif text-white text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-4"
      >
        Alfombra para la Musala
      </h1>
      <p
        class="font-sans text-lg md:text-xl text-crema/80 font-light leading-relaxed max-w-2xl mx-auto"
      >
        "Los lugares más amados por Allāh son las mezquitas"
      </p>
    </div>
  </section>

  <section class="py-16 bg-gris-claro">
    <div class="max-w-[600px] mx-auto px-6">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 text-center">
        <span
          class="inline-block bg-green-600 text-white text-sm font-bold px-4 py-1.5 rounded-full mb-6"
        >
          ¡Conseguido!
        </span>
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div>
            <p class="text-xs text-marron uppercase tracking-wide mb-1">
              Recaudado
            </p>
            <p class="font-serif text-2xl font-bold text-chocolate">
              {raised.toLocaleString()} €
            </p>
          </div>
          <div>
            <p class="text-xs text-marron uppercase tracking-wide mb-1">
              Meta
            </p>
            <p class="font-serif text-2xl font-bold text-chocolate">
              {goal.toLocaleString()} €
            </p>
          </div>
        </div>
        <p class="text-green-700 font-medium text-sm">
          ¡Meta superada! Recaudamos {raised.toLocaleString()} € de {goal.toLocaleString()} €.
          Gracias a todos los que contribuyeron. La alfombra para la musala es una realidad.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .selected {
    border-color: var(--color-oro) !important;
    background: rgba(187, 148, 87, 0.05) !important;
  }
</style>
