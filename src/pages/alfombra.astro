---
import Layout from "../layouts/Layout.astro";
import { getCampaign } from "../lib/sanity";

const campaign = await getCampaign("alfombra");
const goal = campaign?.goal ?? 1000;
const raised = campaign?.raised ?? 0;
const remaining = goal - raised;
const percentage = goal > 0 ? Math.round((raised / goal) * 100) : 0;
---

<Layout title="Alfombra para la Musala">


  <section class="py-16 bg-gris-claro">
    <div class="max-w-[600px] mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-serif text-2xl md:text-3xl font-bold text-chocolate mb-3">
          Ayúdanos a conseguir la alfombra
        </h2>
        <p class="text-sm text-marron font-medium tracking-wide uppercase">
          Necesitamos {goal.toLocaleString()} € para la alfombra de la musala
        </p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
        <div class="grid grid-cols-3 gap-4 mb-6 text-center">
          <div>
            <p class="text-xs text-marron uppercase tracking-wide mb-1">Recaudado</p>
            <p class="font-serif text-2xl font-bold text-chocolate">{raised.toLocaleString()} €</p>
          </div>
          <div>
            <p class="text-xs text-marron uppercase tracking-wide mb-1">Meta</p>
            <p class="font-serif text-2xl font-bold text-chocolate">{goal.toLocaleString()} €</p>
          </div>
          <div>
            <p class="text-xs text-marron uppercase tracking-wide mb-1">Faltan</p>
            <p class="font-serif text-2xl font-bold text-oro">{remaining.toLocaleString()} €</p>
          </div>
        </div>

        <div class="w-full bg-gray-200 rounded-full h-4 mb-2 overflow-hidden">
          <div
            class="bg-oro h-full rounded-full transition-all duration-500"
            style={`width: ${Math.min(percentage, 100)}%`}
          ></div>
        </div>
        <p class="text-right text-xs text-marron mb-8">{percentage}% completado</p>

        <p class="font-serif text-lg font-bold text-chocolate mb-4 text-center">
          Elige tu contribución
        </p>

        <div class="grid grid-cols-3 gap-3 mb-6">
          <button
            class="amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
            data-amount="10"
          >10 €</button>
          <button
            class="amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
            data-amount="20"
          >20 €</button>
          <button
            class="amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
            data-amount="50"
          >50 €</button>
          <button
            class="amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
            data-amount="100"
          >100 €</button>
          <button
            class="amount-btn border-2 border-oro bg-oro/5 rounded-lg py-3 px-4 text-center transition-colors cursor-pointer font-bold text-chocolate"
            data-amount="200"
          >200 €</button>
          <button
            class="amount-btn border border-gray-200 rounded-lg py-3 px-4 text-center hover:border-oro hover:text-oro transition-colors cursor-pointer font-medium text-chocolate"
            data-amount="500"
          >500 €</button>
        </div>

        <div class="mb-6">
          <label class="block text-sm text-marron mb-2">Otra cantidad</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-chocolate font-medium">€</span>
            <input
              type="number"
              id="custom-amount"
              min="1"
              step="1"
              placeholder="0"
              class="w-full border border-gray-200 rounded-lg py-3 pl-10 pr-4 text-chocolate font-medium focus:outline-none focus:border-oro focus:ring-1 focus:ring-oro"
            />
          </div>
        </div>

        <div class="space-y-3 mb-6">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" id="cover-fees" class="mt-1" checked />
            <span class="text-sm text-marron">Cubrir la comisión para que el 100% llegue a la alfombra</span>
          </label>
        </div>

        <div class="space-y-3">
          <button
            id="stripe-btn"
            class="w-full bg-chocolate text-white text-center py-3 px-6 rounded-lg font-medium hover:bg-chocolate/90 transition-colors cursor-pointer border-none text-base"
          >
            Donar con tarjeta
          </button>

          <div id="paypal-btn" class="w-full"></div>

          <details class="group">
            <summary class="list-none w-full text-center py-3 px-6 rounded-lg font-medium border border-oro text-oro hover:bg-oro/5 transition-colors cursor-pointer">
              Transferencia bancaria
            </summary>
            <div class="mt-4 p-4 bg-gris-claro rounded-lg space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-marron">Banco</span>
                <span class="text-chocolate font-medium">BBVA Bancomer</span>
              </div>
              <div class="flex justify-between">
                <span class="text-marron">CLABE</span>
                <span class="text-chocolate font-mono font-medium">00743521001566551081</span>
              </div>
              <div class="flex justify-between">
                <span class="text-marron">Titular</span>
                <span class="text-chocolate font-medium">Sheij Khaled Huerta</span>
              </div>
              <div class="flex justify-between">
                <span class="text-marron">Referencia</span>
                <span class="text-chocolate font-medium">ALFOMBRA</span>
              </div>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <div class="bg-oro/5 border border-oro/20 rounded-xl p-8 md:p-12">
        <p class="font-serif text-xl md:text-2xl text-chocolate italic leading-relaxed mb-6">
          "Quien construye una mezquita para Allāh, Allāh le construirá una casa
          en el Paraíso." (Al-Bujari)
        </p>
        <p class="text-sm text-marron leading-relaxed">
          Cada alfombra colocada en la musala es parte de la casa de Allāh.
          Tu donación se convierte en sadaqah jariyah — caridad continua —
          cada vez que alguien rece sobre ella.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .amount-btn.selected {
    border-color: var(--color-oro, #bb9457);
    background-color: rgba(187, 148, 87, 0.05);
    font-weight: 700;
    color: var(--color-chocolate, #432818);
  }
</style>

<script>
  const amountBtns = document.querySelectorAll(".amount-btn");
  const customAmount = document.getElementById("custom-amount");
  const coverFees = document.getElementById("cover-fees");
  const stripeBtn = document.getElementById("stripe-btn");

  amountBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      amountBtns.forEach((b) => b.classList.remove("selected"));
      btn.classList.add("selected");
      customAmount.value = btn.dataset.amount;
    });
  });

  customAmount.addEventListener("input", () => {
    amountBtns.forEach((b) => b.classList.remove("selected"));
  });

  stripeBtn.addEventListener("click", async () => {
    const amount = parseInt(customAmount.value);
    if (!amount || amount < 1) {
      alert("Selecciona una cantidad");
      return;
    }

    stripeBtn.disabled = true;
    stripeBtn.textContent = "Procesando...";

    try {
      const res = await fetch("/api/create-checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ amount, campaignSlug: "alfombra" }),
      });

      const data = await res.json();

      if (data.url) {
        window.location.href = data.url;
      } else {
        alert("Error al procesar el pago. Intenta de nuevo.");
      }
    } catch {
      alert("Error de conexión. Intenta de nuevo.");
    } finally {
      stripeBtn.disabled = false;
      stripeBtn.textContent = "Donar con tarjeta";
    }
  });

  const paypalScript = document.createElement("script");
  const clientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
  if (!clientId || clientId === "TU_PAYPAL_CLIENT_ID") {
    const fallback = document.getElementById("paypal-btn");
    if (fallback) {
      fallback.innerHTML = `<a href="https://www.paypal.com/paypalme/huertakhaled" target="_blank" rel="noopener noreferrer" class="block w-full text-center py-3 px-6 rounded-lg font-medium border border-gray-300 text-chocolate hover:border-oro hover:text-oro transition-colors no-underline">Donar con PayPal</a>`;
    }
  } else {
    paypalScript.src = `https://www.paypal.com/sdk/js?client-id=${clientId}&currency=EUR`;
    paypalScript.onload = () => {
      (window as any).paypal?.Buttons?.({
        style: { layout: "horizontal", shape: "rect", label: "paypal", tagline: false },
        createOrder() {
          const amount = parseInt(customAmount.value);
          if (!amount || amount < 1) {
            alert("Selecciona una cantidad");
            throw new Error("Missing amount");
          }
          return fetch("/api/create-paypal-order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ amount, campaignSlug: "alfombra" }),
          }).then(r => r.json()).then(d => d.id);
        },
        onApprove(data: any) {
          return fetch("/api/capture-paypal-order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ orderID: data.orderID, campaignSlug: "alfombra" }),
          }).then(() => {
            window.location.href = "/donar?donacion=exito";
          });
        },
      })?.render("#paypal-btn");
    };
    document.head.appendChild(paypalScript);
  }
</script>
