---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  label?: string;
  quote?: string;
  title: string;
  titleAccent?: string;
  description?: string;
  typing?: boolean;
  size?: "full" | "short";
  overlay?: "solid" | "gradient" | "gradient-dark";
  maxWidth?: string;
  titleSize?: "xl" | "lg" | "md";
  imagePosition?: string;
  imageClass?: string;
}

const {
  image,
  label,
  quote,
  title,
  titleAccent,
  description,
  typing = false,
  size = "full",
  overlay = "solid",
  maxWidth = "800px",
  titleSize = "xl",
  imagePosition,
  imageClass = "",
} = Astro.props;

const sectionClass =
  size === "full"
    ? "min-h-[calc(100svh-5rem)] md:min-h-[calc(100vh-5rem)] py-20 md:py-28"
    : "min-h-[60vh] py-28 md:py-36";

const overlayClass =
  overlay === "gradient"
    ? "bg-gradient-to-b from-chocolate/95 via-chocolate/90 to-chocolate/[0.97]"
    : overlay === "gradient-dark"
      ? "bg-gradient-to-b from-chocolate/95 via-chocolate/[0.92] to-chocolate/[0.97]"
      : "bg-chocolate/[0.97]";

const titleClass =
  titleSize === "xl"
    ? "text-4xl md:text-6xl"
    : titleSize === "lg"
      ? "text-3xl md:text-5xl"
      : "text-4xl md:text-5xl";

const accentIndex = titleAccent ? title.indexOf(titleAccent) : -1;
const hasAccent = accentIndex >= 0;
---

<section
  class={`relative text-center overflow-hidden flex flex-col justify-center ${sectionClass}`}
>
  <Image
    src={image}
    alt=""
    class={`absolute inset-0 w-full h-full object-cover contrast-110 saturate-105 ${imageClass}`}
    style={imagePosition ? `object-position: ${imagePosition}` : ""}
    widths={[480, 768, 1024, 1440, 1920]}
    sizes="100vw"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    aria-hidden="true"
  />
  <div class={`absolute inset-0 ${overlayClass}`}></div>
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent pointer-events-none"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_35%,rgba(0,0,0,0.28)_100%)] pointer-events-none"
  >
  </div>

  <div
    class={`relative z-10 mx-auto px-6 hero-content`}
    style={`max-width: ${maxWidth}`}
  >
    {
      quote ? (
        <p class="font-serif text-oro text-lg md:text-xl italic font-semibold mb-6 leading-relaxed max-w-2xl mx-auto">
          {quote}
        </p>
      ) : label ? (
        <span class="inline-flex items-center gap-2 rounded-full border border-oro/30 bg-white/5 px-4 py-1.5 backdrop-blur-sm font-sans text-[11px] font-bold tracking-[0.2em] text-oro uppercase mb-6">
          <span class="h-1.5 w-1.5 rounded-full bg-oro" aria-hidden="true" />
          {label}
        </span>
      ) : (
        <slot name="label" />
      )
    }

    <h1
      class={`hero-title font-serif font-bold tracking-[-0.02em] text-balance leading-[1.08] text-white mb-5 ${titleClass}`}
    >
      {
        hasAccent && titleAccent ? (
          <>
            {title.slice(0, accentIndex)}
            <span class="text-oro">{titleAccent}</span>
            {title.slice(accentIndex + titleAccent.length)}
          </>
        ) : (
          title
        )
      }
    </h1>

    {
      description &&
        (typing ? (
          <p
            class="font-mono text-base md:text-lg text-crema/80 font-normal leading-relaxed max-w-2xl mx-auto mb-8 typing-line"
            data-text={description}
          >
            <span class="text-oro font-bold mr-1.5">❯</span>
            <span class="typing-text"></span>
            <span class="typing-cursor">▌</span>
          </p>
        ) : (
          <p class="font-sans text-base md:text-lg text-white/75 leading-relaxed max-w-xl mx-auto mb-8">
            {description}
          </p>
        ))
    }

    <slot />
  </div>
</section>

<script>
  import gsap from "gsap";

  const init = () => {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!reduceMotion) {
      gsap.from(".hero-content > *", {
        y: 20,
        opacity: 0,
        duration: 0.45,
        stagger: 0.08,
        ease: "power2.out",
        force3D: true,
      });
    }

    const typingLines = document.querySelectorAll(".typing-line");
    if (typingLines.length) {
      typingLines.forEach((line) => {
        const text = line.dataset.text || "";
        const el = line.querySelector(".typing-text");
        if (!el) return;

        el.textContent = "";

        if (reduceMotion) {
          el.textContent = text;
          return;
        }

        let i = 0;
        const type = () => {
          if (i <= text.length) {
            el.textContent = text.slice(0, i);
            i++;
            setTimeout(type, 40 + Math.random() * 70);
          }
        };
        setTimeout(type, 600);
      });
    }
  };

  init();
  if (!(window as any).__heroInit) {
    (window as any).__heroInit = true;
    document.addEventListener("astro:after-swap", init);
  }
</script>

<style>
  @keyframes typing-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .typing-cursor {
    animation: typing-blink 1s steps(1) infinite;
    margin-left: 2px;
  }
</style>
