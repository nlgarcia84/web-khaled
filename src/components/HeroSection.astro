---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  label?: string;
  quote?: string;
  title: string;
  description?: string;
  typing?: boolean;
  size?: "full" | "short";
  overlay?: "solid" | "gradient" | "gradient-dark";
  maxWidth?: string;
  titleSize?: "xl" | "lg" | "md";
  imagePosition?: string;
  imageClass?: string;
}

const {
  image,
  label,
  quote,
  title,
  description,
  typing = false,
  size = "full",
  overlay = "solid",
  maxWidth = "800px",
  titleSize = "xl",
  imagePosition,
  imageClass = "",
} = Astro.props;

const sectionClass =
  size === "full"
    ? "min-h-[calc(100svh-5rem)] md:min-h-[calc(100vh-5rem)] py-20 md:py-28"
    : "min-h-[60vh] py-28 md:py-36";

const overlayClass =
  overlay === "gradient"
    ? "bg-gradient-to-b from-chocolate/85 via-chocolate/75 to-chocolate/95"
    : overlay === "gradient-dark"
      ? "bg-gradient-to-b from-chocolate/85 via-chocolate/80 to-chocolate/95"
      : "bg-chocolate/90";

const titleClass =
  titleSize === "xl"
    ? "text-4xl md:text-6xl"
    : titleSize === "lg"
      ? "text-3xl md:text-5xl"
      : "text-4xl md:text-5xl";
---

<section
  class={`relative text-center overflow-hidden flex flex-col justify-center ${sectionClass}`}
>
  <Image
    src={image}
    alt=""
    class={`absolute inset-0 w-full h-full object-cover contrast-110 saturate-105 ${imageClass}`}
    style={imagePosition ? `object-position: ${imagePosition}` : ""}
    fetchpriority="high"
    aria-hidden="true"
  />
  <div class={`absolute inset-0 ${overlayClass}`}></div>

  <div
    class={`relative z-10 mx-auto px-6 hero-content`}
    style={`max-width: ${maxWidth}`}
  >
    {
      quote ? (
        <p class="font-serif text-oro text-lg md:text-xl italic font-semibold mb-6 leading-relaxed">
          {quote}
        </p>
      ) : label ? (
        <span class="font-sans text-xs font-bold tracking-[0.2em] text-oro uppercase block mb-4">
          {label}
        </span>
      ) : (
        <slot name="label" />
      )
    }

    <h1
      class={`font-serif font-bold tracking-tight text-white leading-tight mb-6 ${titleClass}`}
    >
      {title}
    </h1>

    {
      description &&
        (typing ? (
          <p
            class="font-mono text-base md:text-lg text-crema/80 font-normal leading-relaxed max-w-2xl mx-auto mb-8 typing-line"
            data-text={description}
          >
            <span class="text-oro font-bold mr-1.5">❯</span>
            <span class="typing-text"></span>
            <span class="typing-cursor">▌</span>
          </p>
        ) : (
          <p class="font-sans text-lg md:text-xl text-crema/80 font-light leading-relaxed max-w-2xl mx-auto mb-8">
            {description}
          </p>
        ))
    }

    <slot />
  </div>
</section>

<script>
  import gsap from "gsap";

  const init = () => {
    gsap.from(".hero-content > *", {
      y: 40,
      opacity: 0,
      duration: 0.5,
      stagger: 0.08,
      ease: "power1.out",
      force3D: true,
    });

    const typingLines = document.querySelectorAll(".typing-line");
    if (typingLines.length) {
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      typingLines.forEach((line) => {
        const text = line.dataset.text || "";
        const el = line.querySelector(".typing-text");
        if (!el) return;

        el.textContent = "";

        if (reduceMotion) {
          el.textContent = text;
          return;
        }

        let i = 0;
        const type = () => {
          if (i <= text.length) {
            el.textContent = text.slice(0, i);
            i++;
            setTimeout(type, 40 + Math.random() * 70);
          }
        };
        setTimeout(type, 600);
      });
    }
  };

  init();
  if (!(window as any).__heroInit) {
    (window as any).__heroInit = true;
    document.addEventListener("astro:after-swap", init);
  }
</script>

<style>
  @keyframes typing-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .typing-cursor {
    animation: typing-blink 1s steps(1) infinite;
    margin-left: 2px;
  }
</style>
