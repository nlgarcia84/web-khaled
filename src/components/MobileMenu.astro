---
/**
 * MobileMenu — menú de navegación tipo hamburguesa para móviles (vanilla JS).
 *
 * - Botón que alterna entre icono hamburguesa y "X"
 * - Overlay semitransparente que cierra el menú al hacer clic
 * - Cierra con la tecla Escape
 * - Atributos ARIA para accesibilidad
 */
const MenuIcon = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 6h16M4 12h16M4 18h16'/></svg>";
---

<button
  id="mobile-menu-btn"
  aria-label="Abrir menú"
  aria-expanded="false"
  class="md:hidden relative z-[60] flex h-10 w-10 items-center justify-center text-white"
>
  <span class="menu-icon" set:html={MenuIcon} />
</button>

<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-40 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300"
/>

<aside
  id="mobile-menu"
  class="fixed right-0 top-0 z-50 h-screen w-80 bg-white shadow-xl translate-x-full transition-transform duration-300"
>
  <nav class="flex flex-col p-8 gap-6">
    <a href="/" class="text-chocolate hover:text-oro transition-colors no-underline font-medium">Inicio</a>
    <a href="/biografia" class="text-chocolate hover:text-oro transition-colors no-underline font-medium">Sobre mí</a>
    <a href="/blog" class="text-chocolate hover:text-oro transition-colors no-underline font-medium">Blog</a>
    <a href="/contact" class="text-chocolate hover:text-oro transition-colors no-underline font-medium">Contacto</a>
    <a href="/jutbas" class="text-chocolate hover:text-oro transition-colors no-underline font-medium">Jutbas</a>
    <a href="/audios" class="text-chocolate hover:text-oro transition-colors no-underline font-medium">Audios</a>
    <a href="/biblioteca" class="text-chocolate hover:text-oro transition-colors no-underline font-medium">Biblioteca</a>
    <a href="/donar" class="inline-block bg-oro text-chocolate font-bold px-4 py-2 rounded-lg text-sm no-underline">
      Donar
    </a>
  </nav>
</aside>

